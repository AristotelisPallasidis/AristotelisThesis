<Window x:Class="AvailableCamerasAutomaticLoad.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:AvailableCamerasAutomaticLoad"
        mc:Ignorable="d"
        Title="Available Cameras" Height="450" Width="800"
        Loaded="Window_Loaded" Closing="Window_Closing">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Add Refresh Button -->
        <StackPanel Grid.Column="0">
            <Button Content="Refresh" Click="RefreshButton_Click" Width="100" Margin="5"/>
            <ListBox x:Name="CameraList" HorizontalAlignment="Left" VerticalAlignment="Top" Width="200" SelectionChanged="CameraList_SelectionChanged"/>
        </StackPanel>

        <!-- This Image control will display the live feed -->
        <Image Grid.Column="1" x:Name="CameraFeed" Stretch="Fill" />
    </Grid>
</Window>
