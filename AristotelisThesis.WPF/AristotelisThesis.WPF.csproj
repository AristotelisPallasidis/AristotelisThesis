<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="AForge.Video.DirectShow" Version="2.2.5" />
    <PackageReference Include="LoadingSpinner.WPF" Version="1.0.0" />
    <PackageReference Include="OpenCvSharp4" Version="4.13.0.20260602" />
    <PackageReference Include="OpenCvSharp4.runtime.win" Version="4.13.0.20260602" />
    <PackageReference Include="OpenCvSharp4.Windows" Version="4.13.0.20260602" />
    <PackageReference Include="System.Drawing.Common" Version="10.0.9" />
  </ItemGroup>

  <ItemGroup>
    <!-- Every image is embedded so it resolves via pack URI on any machine, rather than
         from a filesystem path that only exists on the developer's. -->
    <None Remove="Assets\**\*.png" />
    <None Remove="Assets\**\*.jpg" />
    <None Remove="Assets\**\*.jpeg" />
    <None Remove="Assets\**\*.ico" />
    <Resource Include="Assets\**\*.png" />
    <Resource Include="Assets\**\*.jpg" />
    <Resource Include="Assets\**\*.jpeg" />
    <Resource Include="Assets\**\*.ico" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\AristotelisThesis.Domain\AristotelisThesis.Domain.csproj" />
    <ProjectReference Include="..\AristotelisThesis.EntityFramework\AristotelisThesis.EntityFramework.csproj" />
  </ItemGroup>

</Project>
