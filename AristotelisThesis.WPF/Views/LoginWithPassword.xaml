<UserControl x:Class="AristotelisThesis.WPF.Views.LoginWithPassword"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:AristotelisThesis.WPF.Views"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>

        <StackPanel Orientation="Vertical" Width="300" VerticalAlignment="Center">
            
            <TextBlock Text="Username" FontSize="16" Foreground="white"></TextBlock>
            <TextBox 
                Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}">
            </TextBox>
        
            <TextBlock Text="Password" FontSize="16" Foreground="white"></TextBlock>
            <TextBox 
                Text="{Binding Password, UpdateSourceTrigger=PropertyChanged}">
            </TextBox>
            
            <Button x:Name="loginButton" Content="Login" Margin="0 30 "></Button>
            <Button x:Name="BackBtn" Content="Back" ></Button>
        
        </StackPanel>
        
    </Grid>
</UserControl>
