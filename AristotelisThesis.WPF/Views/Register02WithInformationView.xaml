<UserControl x:Class="AristotelisThesis.WPF.Views.Register02WithInformationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:AristotelisThesis.WPF.Views"
             mc:Ignorable="d" 
             d:DesignHeight="650" d:DesignWidth="1200" Background="#1D1C1D">
    
    
    <Grid Margin="20">

        <Grid.RowDefinitions>
            <RowDefinition Height="auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="auto" />
        </Grid.RowDefinitions>

        

        <Grid Grid.Column="0" Grid.Row="0" Margin="0 20 0 10">
            <TextBlock
                Text="Εισαγωγή προσωπικών στοιχείων"
                Grid.Row="0"
                FontFamily="Manrope"
                FontSize="20"
                FontWeight="Bold"
                Foreground="White"
                >
            </TextBlock>
        </Grid>

        <!-- CONTENT -->
        <Grid Grid.Row="1" Margin="0 20">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0">

                <Grid.RowDefinitions>
                    <RowDefinition Height="auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <TextBlock 
                        Text="Προσωπικά Στοιχεία" 
                        Foreground="White" 
                        FontSize="16" 
                        FontWeight="ExtraBold" 
                        FontFamily="Manrope">
                    </TextBlock>
                </Grid>


                <Grid Grid.Row="1">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Grid Grid.Column="0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="auto" />
                            <RowDefinition Height="auto" />
                            <RowDefinition Height="auto" />
                            <RowDefinition Height="auto" />
                            <RowDefinition Height="auto" />
                            <RowDefinition Height="auto" />
                        </Grid.RowDefinitions>

                        <!-- First name -->
                        <TextBlock
                    Grid.Row="0"
                    Text="Όνομα:"
                    Style="{StaticResource TextBlockOfInput}">
                        </TextBlock>
                        <TextBox 
                    Grid.Row="1"
                    Style="{StaticResource TextBoxOfInput}"
                    MaxLength="20" 
                    AcceptsReturn="False">
                        </TextBox>

                        <!-- Address -->
                        <TextBlock
                    Grid.Row="2"
                    Text="Διεύθυνση Κατοικίας:"
                    Style="{StaticResource TextBlockOfInput}">
                        </TextBlock>
                        <TextBox 
                    Grid.Row="3"
                    Style="{StaticResource TextBoxOfInput}"
                    MaxLength="20" 
                    AcceptsReturn="False">
                        </TextBox>

                        <!-- Gender -->
                        <TextBlock
                    Grid.Row="4"
                    Text="Φύλο:"
                    Style="{StaticResource TextBlockOfInput}">
                        </TextBlock>
                        <StackPanel Orientation="Horizontal" Grid.Row="5">
                            <RadioButton 
                        Content="Αρσενικό"
                        Foreground="{StaticResource ColorLight}"
                        FontSize="14"
                        FontFamily="Manrope"
                        Margin="0 0 16 0">
                            </RadioButton>
                            <RadioButton 
                        Content="Θυληκό"
                        Foreground="{StaticResource ColorLight}"
                        FontSize="14"
                        FontFamily="Manrope">
                            </RadioButton>
                        </StackPanel>

                    </Grid>


                    <Grid Grid.Column="1">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="auto" />
                            <RowDefinition Height="auto" />
                            <RowDefinition Height="auto" />
                            <RowDefinition Height="auto" />
                            <RowDefinition Height="auto" />
                            <RowDefinition Height="auto" />
                        </Grid.RowDefinitions>


                        <!-- Last name -->
                        <TextBlock
                     Grid.Row="0"
                     Text="Επίθετο:"
                     Style="{StaticResource TextBlockOfInput}">
                        </TextBlock>
                        <TextBox 
                     Grid.Row="1"
                     Style="{StaticResource TextBoxOfInput}"
                     MaxLength="20" 
                     AcceptsReturn="False">
                        </TextBox>

                        <!-- Contact Phone -->
                        <TextBlock
                    Grid.Row="2"
                    Text="Τηλέφωνο Επικοινωνίας:"
                    Style="{StaticResource TextBlockOfInput}">
                        </TextBlock>
                        <TextBox 
                    Grid.Row="3"
                    Style="{StaticResource TextBoxOfInput}"
                    MaxLength="9" 
                    AcceptsReturn="False">
                        </TextBox>

                        <!-- Ημερομηνία Γέννησης -->
                        <TextBlock
                    Grid.Row="4"
                    Text="Ημερομηνία Γέννησης:dd/mm/yyyy"
                    Style="{StaticResource TextBlockOfInput}">
                        </TextBlock>
                        <TextBox 
                    Grid.Row="5"
                    Style="{StaticResource TextBoxOfInput}"
                    MaxLength="9" 
                    AcceptsReturn="False">
                        </TextBox>

                    </Grid>




                </Grid>


            </Grid>

            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="auto" />
                    <RowDefinition Height="auto" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <TextBlock 
                        Text="Ακαδημαϊκά Στοιχεία" 
                        Foreground="White" 
                        FontSize="16" 
                        FontWeight="ExtraBold" 
                        FontFamily="Manrope">
                    </TextBlock>
                </Grid>


                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>


                    <Grid Grid.Column="0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- Academic Email -->
                        <TextBlock
                    Grid.Row="0"
                    Text="Ακαδημαϊκό Ηλεκτρ. Ταχυδρομείο"
                    Style="{StaticResource TextBlockOfInput}">
                        </TextBlock>
                        <TextBox 
                    Grid.Row="1"
                    Style="{StaticResource TextBoxOfInput}"
                    MaxLength="20" 
                    AcceptsReturn="False">
                        </TextBox>

                        <!-- Department -->
                        <TextBlock
                    Grid.Row="4"
                    Text="Τμήμα"
                    Style="{StaticResource TextBlockOfInput}">
                        </TextBlock>
                        <TextBox 
                    Grid.Row="5"
                    Style="{StaticResource TextBoxOfInput}"
                    MaxLength="20" 
                    AcceptsReturn="False">
                        </TextBox>

                        <!-- Year of Study -->
                        <TextBlock
                    Grid.Row="6"
                    Text="Χρονιά Εισαγωγής"
                    Style="{StaticResource TextBlockOfInput}">
                        </TextBlock>
                        <TextBox 
                    Grid.Row="7"
                    Style="{StaticResource TextBoxOfInput}"
                    MaxLength="20" 
                    AcceptsReturn="False">
                        </TextBox>



                    </Grid>

                    <Grid Grid.Column="1">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="auto" />
                            <RowDefinition Height="auto" />
                            <RowDefinition Height="auto" />
                            <RowDefinition Height="auto" />
                        </Grid.RowDefinitions>

                        <!-- AEM -->
                        <TextBlock
                    Grid.Row="0"
                    Text="ΑΕΜ Φοιτητή"
                    Style="{StaticResource TextBlockOfInput}">
                        </TextBlock>
                        <TextBox 
                    Grid.Row="1"
                    Style="{StaticResource TextBoxOfInput}"
                    MaxLength="20" 
                    AcceptsReturn="False">
                        </TextBox>

                        <!-- Semester -->
                        <TextBlock
                    Grid.Row="2"
                    Text="Εξάμηνο (Τρέχον)"
                    Style="{StaticResource TextBlockOfInput}">
                        </TextBlock>
                        <TextBox 
                    Grid.Row="3"
                    Style="{StaticResource TextBoxOfInput}"
                    MaxLength="20" 
                    AcceptsReturn="False">
                        </TextBox>

                    </Grid>
                </Grid>


            </Grid>
        </Grid>

        <Grid Grid.Column="0" Grid.Row="2">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                <Button 
                    Content="Επόμενο"
                    Style="{StaticResource NextButton}"
                    Cursor="Hand">
                </Button>
                <Button 
                    Content="Πίσω"
                    Style="{StaticResource BackButton}">
                </Button>
            </StackPanel>
        </Grid>

    </Grid>
</UserControl>
