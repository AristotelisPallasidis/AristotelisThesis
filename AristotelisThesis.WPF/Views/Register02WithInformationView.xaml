<UserControl x:Class="AristotelisThesis.WPF.Views.Register02WithInformationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:AristotelisThesis.WPF.Views"
             mc:Ignorable="d" 
             d:DesignWidth="1920" d:DesignHeight="1080"
             Background="#1D1C1D">

    <Grid Margin="40">

        <Grid.RowDefinitions>
            <RowDefinition Height="auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Column="0" Grid.Row="0" Margin="0 20 0 10">
            <TextBlock
                Text="Εισαγωγή προσωπικών στοιχείων"
                Grid.Row="0"
                Style="{StaticResource PageTitle}">
            </TextBlock>
        </Grid>

        <!-- CONTENT -->
        <Grid Grid.Row="1" Margin="0 20">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0">

                <Grid.RowDefinitions>
                    <RowDefinition Height="auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <TextBlock 
                        Text="Προσωπικά Στοιχεία" 
                        Foreground="White" 
                        FontSize="24" 
                        FontWeight="ExtraBold" 
                        FontFamily="Manrope">
                    </TextBlock>
                </Grid>


                <Grid Grid.Row="1">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Grid Grid.Column="0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="auto" />
                            <RowDefinition Height="auto" />
                            <RowDefinition Height="auto" />
                            <RowDefinition Height="auto" />
                            <RowDefinition Height="auto" />
                            <RowDefinition Height="auto" />
                        </Grid.RowDefinitions>

                        <!-- First name -->
                        <TextBlock
                    Grid.Row="0"
                    Style="{StaticResource TextBlockOfInput}"><Run Text="Όνομα:" /><Run Text=" *" Foreground="Red" />
                        </TextBlock>
                        <TextBox
                    Grid.Row="1"
                    Style="{StaticResource TextBoxOfInput}"
                    MaxLength="20"
                    AcceptsReturn="False"
                    Text="{Binding Registration.Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                        </TextBox>

                        <!-- Address -->
                        <TextBlock
                    Grid.Row="2"
                    Style="{StaticResource TextBlockOfInput}"><Run Text="Διεύθυνση Κατοικίας:" /><Run Text=" *" Foreground="Red" />
                        </TextBlock>
                        <TextBox
                    Grid.Row="3"
                    Style="{StaticResource TextBoxOfInput}"
                    MaxLength="200"
                    AcceptsReturn="False"
                    Text="{Binding Registration.Address, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                        </TextBox>

                        <!-- Gender -->
                        <TextBlock
                    Grid.Row="4"
                    Text="Φύλο:"
                    Style="{StaticResource TextBlockOfInput}">
                        </TextBlock>
                        <StackPanel Orientation="Horizontal" Grid.Row="5">
                            <RadioButton
                        Content="Αρσενικό"
                        Foreground="{StaticResource ColorLight}"
                        FontSize="14"
                        FontFamily="Manrope"
                        Margin="0 0 16 0"
                        IsChecked="{Binding Registration.IsMale, Mode=TwoWay}">
                            </RadioButton>
                            <RadioButton
                        Content="Θυληκό"
                        Foreground="{StaticResource ColorLight}"
                        FontSize="14"
                        FontFamily="Manrope"
                        IsChecked="{Binding Registration.IsFemale, Mode=TwoWay}">
                            </RadioButton>
                        </StackPanel>

                    </Grid>


                    <Grid Grid.Column="1">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="auto" />
                            <RowDefinition Height="auto" />
                            <RowDefinition Height="auto" />
                            <RowDefinition Height="auto" />
                            <RowDefinition Height="auto" />
                            <RowDefinition Height="auto" />
                        </Grid.RowDefinitions>


                        <!-- Last name -->
                        <TextBlock
                     Grid.Row="0"
                     Style="{StaticResource TextBlockOfInput}"><Run Text="Επίθετο:" /><Run Text=" *" Foreground="Red" />
                        </TextBlock>
                        <TextBox
                     Grid.Row="1"
                     Style="{StaticResource TextBoxOfInput}"
                     MaxLength="20"
                     AcceptsReturn="False"
                     Text="{Binding Registration.Surname, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                        </TextBox>

                        <!-- Contact Phone -->
                        <TextBlock
                    Grid.Row="2"
                    Style="{StaticResource TextBlockOfInput}"><Run Text="Τηλέφωνο Επικοινωνίας:" /><Run Text=" *" Foreground="Red" />
                        </TextBlock>
                        <TextBox
                            Grid.Row="3"
                            Style="{StaticResource TextBoxOfInput}"
                            MaxLength="10"
                            AcceptsReturn="False"
                            Text="{Binding Registration.Phone, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                        </TextBox>

                        <!-- Ημερομηνία Γέννησης -->
                        <TextBlock
                            Grid.Row="4"
                            Style="{StaticResource TextBlockOfInput}"><Run Text="Ημερομηνία Γέννησης:dd/mm/yyyy" /><Run Text=" *" Foreground="Red" />
                        </TextBlock>
                        <TextBox
                            Grid.Row="5"
                            Style="{StaticResource TextBoxOfInput}"
                            MaxLength="10"
                            AcceptsReturn="False"
                            Text="{Binding Registration.DateOfBirth, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                        </TextBox>

                    </Grid>




                </Grid>


            </Grid>

            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="auto" />
                    <RowDefinition Height="auto" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <TextBlock 
                        Text="Ακαδημαϊκά Στοιχεία" 
                        Foreground="White" 
                        FontSize="24" 
                        FontWeight="ExtraBold" 
                        FontFamily="Manrope">
                    </TextBlock>
                </Grid>


                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>


                    <Grid Grid.Column="0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- Academic Email -->
                        <TextBlock
                    Grid.Row="0"
                    Style="{StaticResource TextBlockOfInput}"><Run Text="Ακαδημαϊκό Ηλεκτρ. Ταχυδρομείο" /><Run Text=" *" Foreground="Red" />
                        </TextBlock>
                        <TextBox
                    Grid.Row="1"
                    Style="{StaticResource TextBoxOfInput}"
                    MaxLength="50"
                    AcceptsReturn="False"
                    Text="{Binding Registration.AcademicEmail, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                        </TextBox>

                        <!-- Department -->
                        <TextBlock
                    Grid.Row="4"
                    Style="{StaticResource TextBlockOfInput}"><Run Text="Τμήμα" /><Run Text=" *" Foreground="Red" />
                        </TextBlock>
                        <ComboBox Grid.Row="5"
                            Style="{StaticResource ComboBoxOfInput}"
                            SelectedValuePath="Content"
                            SelectedValue="{Binding Registration.Department, Mode=TwoWay}">
                            <ComboBoxItem Content="Πληροφορική" />
                            <ComboBoxItem Content="Φυσικό" />
                            <ComboBoxItem Content="Χημικό" />
                            <ComboBoxItem Content="Μαθηματικό" />
                        </ComboBox>

                        <!-- Year of Study -->
                        <TextBlock
                    Grid.Row="6"
                    Style="{StaticResource TextBlockOfInput}"><Run Text="Χρονιά Εισαγωγής" /><Run Text=" *" Foreground="Red" />
                        </TextBlock>
                        <ComboBox Grid.Row="7"
                    Style="{StaticResource ComboBoxOfInput}"
                    ItemsSource="{Binding Years}"
                    SelectedItem="{Binding Registration.YearOfEntry, Mode=TwoWay}">
                        </ComboBox>



                    </Grid>

                    <Grid Grid.Column="1">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="auto" />
                            <RowDefinition Height="auto" />
                            <RowDefinition Height="auto" />
                            <RowDefinition Height="auto" />
                            <RowDefinition Height="auto" />
                            <RowDefinition Height="auto" />
                        </Grid.RowDefinitions>

                        <!-- AEM -->
                        <TextBlock
                    Grid.Row="0"
                    Style="{StaticResource TextBlockOfInput}"><Run Text="ΑΕΜ Φοιτητή" /><Run Text=" *" Foreground="Red" />
                        </TextBlock>
                        <TextBox
                    Grid.Row="1"
                    Style="{StaticResource TextBoxOfInput}"
                    MaxLength="5"
                    AcceptsReturn="False"
                    Text="{Binding Registration.Aem, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                        </TextBox>

                        <!-- Semester -->
                        <TextBlock
                    Grid.Row="2"
                    Style="{StaticResource TextBlockOfInput}"><Run Text="Εξάμηνο (Τρέχον)" /><Run Text=" *" Foreground="Red" />
                        </TextBlock>
                        <TextBox
                    Grid.Row="3"
                    Style="{StaticResource TextBoxOfInput}"
                    MaxLength="2"
                    AcceptsReturn="False"
                    Text="{Binding Registration.Semester, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                        </TextBox>

                        <!-- Degree -->
                        <TextBlock
                            Grid.Row="4"
                            Text="Πτυχίο:"
                            Style="{StaticResource TextBlockOfInput}">
                        </TextBlock>
                        <StackPanel Orientation="Horizontal" Grid.Row="5">
                            <RadioButton
                                Content="Προπτυχιακό"
                                Foreground="{StaticResource ColorLight}"
                                FontSize="14"
                                FontFamily="Manrope"
                                Margin="0 0 16 0"
                                IsChecked="{Binding Registration.IsUndergraduate, Mode=TwoWay}">
                            </RadioButton>
                            <RadioButton
                                Content="Μεταπτυχιακό"
                                Foreground="{StaticResource ColorLight}"
                                FontSize="14"
                                FontFamily="Manrope"
                                IsChecked="{Binding Registration.IsPostgraduate, Mode=TwoWay}">
                            </RadioButton>
                        </StackPanel>
                    </Grid>
                </Grid>


            </Grid>
        </Grid>

        <Grid Grid.Column="0" Grid.Row="2">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                <Button 
                    Content="Επόμενο"
                    Command="{Binding GoToViewRegister03InstructionsForPalmprintCommand}"
                    Style="{StaticResource NextButton}"
                    Cursor="Hand">
                </Button>
                <Button 
                    Content="Πίσω"
                    Command="{Binding GoToViewRegister01Command}"
                    Style="{StaticResource BackButton}">
                </Button>
            </StackPanel>
        </Grid>

    </Grid>
</UserControl>
