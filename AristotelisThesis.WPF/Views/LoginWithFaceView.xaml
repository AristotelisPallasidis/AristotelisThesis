<UserControl x:Class="AristotelisThesis.WPF.Views.LoginWithFaceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:AristotelisThesis.WPF.Views"
             mc:Ignorable="d" 
             d:DesignHeight="850" d:DesignWidth="1440"
             Background="#1D1C1D">
    <Grid Margin="20">

        <Grid.RowDefinitions>
            <RowDefinition Height="auto" />
            <RowDefinition Height="*"/>
            <RowDefinition Height="auto" />
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0" Grid.Row="0" Margin="0,20,0,10">
            <TextBlock
                Text="Σύνδεση μέσω Προσώπου"
                Grid.Row="0"
                Style="{StaticResource PageTitle}">
            </TextBlock>
        </Grid>

        <Grid Grid.Column="0" Grid.Row="1" Margin="0 10 0 0">

            <Grid Grid.Column="0" Grid.Row="1" Margin="0 10 0 0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="auto" />
                    <RowDefinition Height="auto" />
                </Grid.RowDefinitions>

                <!-- Camera Text-->
                <TextBlock
                    Grid.Row="0"
                    Text="Κάμερα"
                    FontFamily="Manrope"
                    FontSize="24"
                    FontWeight="Bold"
                    Foreground="White"
                    Margin="0 0 0 6">
                </TextBlock>


                <!-- Camera Input 
                <Image Grid.Column="1" x:Name="CameraFeed" Stretch="Fill" />
                -->

            </Grid>


        </Grid>

        <Grid Grid.Column="1" Margin="12 57 0 82" Grid.RowSpan="4">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <StackPanel Orientation="Vertical">

                    <StackPanel Orientation="Horizontal">

                        <!-- Available Cameras -->
                        <TextBlock
                            Grid.Row="0"
                            Text="Διαθέσιμες Κάμερες"
                            FontFamily="Manrope"
                            FontSize="24"
                            FontWeight="Bold"
                            Foreground="White"
                            Margin="0 10 0 6">
                        </TextBlock>
                        
                        <!--Click="RefreshButton_Click" -->
                        <Button 
                            Content="Ανανέωση"
                            Margin="30 10 0 6"
                            Padding="18 6"
                            BorderThickness="0"
                            Background="White"
                            FontSize="16"
                            Cursor="Hand">
                        </Button>

                    </StackPanel>

                    <!-- 
                    <ListBox x:Name="CameraList" HorizontalAlignment="Left" VerticalAlignment="Top" Width="200" SelectionChanged="CameraList_SelectionChanged"/>
                    -->

                </StackPanel>
            </Grid>
            <StackPanel Orientation="Horizontal" Grid.Row="1">
                <Button 
                    Grid.Row="3"
                    FontFamily="Manrope"
                    FontSize="16"
                    Content="Βγάλε φωτογραφία"
                    Padding="18 6"
                    Margin="0 0 8 0"
                    BorderThickness="0"
                    Background="White"
                    Foreground="Black"
                    Cursor="Hand">
                </Button>
                <Button 
                    Grid.Row="3"
                    FontFamily="Manrope"
                    FontSize="16"
                    Content="Επανάληψη"
                    Padding="14 6"
                    Margin="0"
                    BorderThickness="0"
                    Background="White"
                    Foreground="Black"
                    Cursor="Hand">
                </Button>
            </StackPanel>
        </Grid>

        <Grid Grid.Column="0" Grid.Row="3" Margin="0,60,0,0">
            <StackPanel Orientation="Horizontal">
                <Button 
                    Content="Σύνδεση"
                    Style="{StaticResource NextButton}">
                </Button>
                <Button 
                    Content="Ακύρωση"
                    Command="{Binding GoToViewLoginCommand}"
                    Style="{StaticResource BackButton}">
                </Button>
            </StackPanel>

        </Grid>

    </Grid>
</UserControl>
