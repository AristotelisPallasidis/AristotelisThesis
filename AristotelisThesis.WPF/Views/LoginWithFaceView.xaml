<UserControl x:Class="AristotelisThesis.WPF.Views.LoginWithFaceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:AristotelisThesis.WPF.Views"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800"
             Background="#1D1C1D">
    <Grid Margin="20">

        <Grid.RowDefinitions>
            <RowDefinition Height="auto" />
            <RowDefinition Height="*"/>
            <RowDefinition Height="auto" />
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0" Grid.Row="0" Margin="0,20,0,10">
            <TextBlock
                Text="Σύνδεση μέσω Προσώπου"
                Grid.Row="0"
                FontFamily="Manrope"
                FontSize="20"
                FontWeight="Bold"
                Foreground="White">
            </TextBlock>
        </Grid>

        <Grid Grid.Column="0" Grid.Row="1" Margin="0 10 0 0">
            <Grid.RowDefinitions>
                <RowDefinition Height="auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Camera Text-->
            <TextBlock
                Grid.Row="0"
                Text="Κάμερα"
                Foreground="White"
                FontFamily="Manrope"
                FontSize="12"
                FontWeight="Bold"
                Margin="0 0 0 6">
            </TextBlock>



            <!-- Camera Input -->
            <!-- 
            <ffme:MediaElemnt x:Name="MediaElement"></ffme:MediaElemnt>
            -->


        </Grid>

        <Grid Grid.Column="1" Margin="12 57 0 82" Grid.RowSpan="4">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="auto" />
            </Grid.RowDefinitions>

            <!-- Available Cameras -->
            <TextBlock
                Grid.Row="0"
                Text="Διαθέσιμες Κάμερες"
                FontFamily="Manrope"
                FontSize="16"
                FontWeight="Bold"
                Foreground="White"
                Margin="0 10 0 6">
            </TextBlock>
            <StackPanel Orientation="Horizontal" Grid.Row="1">
                <Button 
                    Grid.Row="3"
                    Content="Άνοιξε Κάμερα"
                    Padding="18 6"
                    BorderThickness="0"
                    Background="White"
                    Foreground="Black"
                    Cursor="Hand">
                </Button>
                <Button 
                    Grid.Row="3"
                    FontFamily="Manrope"
                    FontSize="12"
                    Content="Βγάλε φωτογραφία"
                    Padding="18 6"
                    Margin="8 0"
                    BorderThickness="0"
                    Background="White"
                    Foreground="Black"
                    Cursor="Hand">
                </Button>
                <Button 
                    Grid.Row="3"
                    FontFamily="Manrope"
                    FontSize="12"
                    Content="Επανάληψη"
                    Padding="14 6"
                    Margin="0"
                    BorderThickness="0"
                    Background="White"
                    Foreground="Black"
                    Cursor="Hand">
                </Button>
            </StackPanel>
        </Grid>

        <Grid Grid.Column="0" Grid.Row="3" Margin="0,60,0,0">
            <StackPanel Orientation="Horizontal">
                <Button 
                    Content="Σύνδεση"
                    Width="100" 
                    Padding="0 3"
                    Foreground="#1D1C1D"
                    Background="#BEDB39"
                    BorderThickness="0"
                    FontFamily="Manrope"
                    FontWeight="SemiBold"
                    Cursor="Hand">
                </Button>
                <Button 
                    Content="Ακύρωση"
                    Width="100"
                    Padding="0 3"
                    Foreground="White" 
                    Background="Transparent"
                    BorderThickness="0"
                    FontFamily="Manrope"
                    Cursor="Hand">
                </Button>
            </StackPanel>

        </Grid>

    </Grid>
</UserControl>
