<UserControl x:Class="AristotelisThesis.WPF.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:AristotelisThesis.WPF.Views"

             xmlns:controls="clr-namespace:AristotelisThesis.WPF.Controls"

             mc:Ignorable="d"
             d:DesignHeight="850" d:DesignWidth="1440">


    <Border Background="#1D1C1D" BorderBrush="Black" BorderThickness="1 1 1 1" CornerRadius="24 24 24 24">
        <Grid Margin="20">

            <Grid.RowDefinitions>
                <RowDefinition Height="auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="auto" />
            </Grid.RowDefinitions>

            <!-- ROW TITLE -->
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" Grid.Column="0">
                    <Image Source="C:\Users\Aristotelis\Desktop\repos\AristotelisThesis\AristotelisThesis.WPF\Assets\Icons\GearIconSolid.png" Width="30" Height="30" Margin="0 0 10 0"></Image>
                    <TextBlock 
                        Text="Ρυθμίσης" 
                        Grid.Column="0"
                        Style="{StaticResource PageTitle}">
                    </TextBlock>
                </StackPanel>


                <!-- CLOCK CARD -->
                <Grid Grid.Column="2">
                    <controls:ClockCard Width="280"/>
                    <!-- <card:ClockCard String Format {Binding Gender dispay end } {Binding nowTime - start }-->
                </Grid>
            </Grid>



            <!-- CONTENT -->
            <Grid Grid.Row="1" Margin="0 20">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0">

                    <Grid.RowDefinitions>
                        <RowDefinition Height="auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <TextBlock 
                            Text="Επεξεργασία Προσωπικών Στοιχείων" 
                            Foreground="White" 
                            FontSize="20" 
                            FontWeight="ExtraBold" 
                            FontFamily="Manrope">
                        </TextBlock>
                    </Grid>


                    <Grid Grid.Row="1">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Grid Grid.Column="0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="auto" />
                                <RowDefinition Height="auto" />
                                <RowDefinition Height="auto" />
                                <RowDefinition Height="auto" />
                                <RowDefinition Height="auto" />
                                <RowDefinition Height="auto" />
                            </Grid.RowDefinitions>

                            <!-- NAME -->
                            <TextBlock
                                Grid.Row="0"
                                Text="Όνομα:"
                                Style="{StaticResource TextBlockOfInput}">
                            </TextBlock>
                            <TextBox 
                                Grid.Row="1"
                                Name="inputName"
                                CaretBrush="White"
                                Style="{StaticResource TextBoxOfInput}"
                                MaxLength="20" 
                                AcceptsReturn="False">
                            </TextBox>

                            <!-- ADDRESS -->
                            <TextBlock
                                Grid.Row="2"
                                Text="Διεύθυνση Κατοικίας:"
                                Style="{StaticResource TextBlockOfInput}">
                            </TextBlock>
                            <TextBox 
                                Grid.Row="3"
                                Name="inputAddress"
                                CaretBrush="White"
                                Style="{StaticResource TextBoxOfInput}"
                                MaxLength="20" 
                                AcceptsReturn="False">
                            </TextBox>

                            <!-- GENDER -->
                            <TextBlock
                                Grid.Row="4"
                                Text="Φύλο:"
                                Style="{StaticResource TextBlockOfInput}">
                            </TextBlock>
                            <StackPanel Orientation="Horizontal" Grid.Row="5">
                                <RadioButton 
                                    Content="Αρσενικό"
                                    Foreground="{StaticResource ColorLight}"
                                    FontSize="14"
                                    FontFamily="Manrope"
                                    Margin="0 0 16 0">
                                </RadioButton>
                                <RadioButton 
                                    Content="Θυληκό"
                                    Foreground="{StaticResource ColorLight}"
                                    FontSize="14"
                                    FontFamily="Manrope">
                                </RadioButton>
                            </StackPanel>

                        </Grid>


                        <Grid Grid.Column="1">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="auto" />
                                <RowDefinition Height="auto" />
                                <RowDefinition Height="auto" />
                                <RowDefinition Height="auto" />
                                <RowDefinition Height="auto" />
                                <RowDefinition Height="auto" />
                            </Grid.RowDefinitions>


                            <!-- SURNAME -->
                            <TextBlock
                                 Grid.Row="0"
                                 Text="Επίθετο:"
                                 Style="{StaticResource TextBlockOfInput}">
                            </TextBlock>
                            <TextBox 
                                 Grid.Row="1"
                                 Name="inputSurname"
                                 CaretBrush="White"
                                 Style="{StaticResource TextBoxOfInput}"
                                 MaxLength="20" 
                                 AcceptsReturn="False">
                            </TextBox>

                            <!-- PHONE NUMBER -->
                            <TextBlock
                                Grid.Row="2"
                                Text="Τηλέφωνο Επικοινωνίας:"
                                Style="{StaticResource TextBlockOfInput}">
                            </TextBlock>
                            <TextBox 
                                Grid.Row="3"
                                Name="inputPhoneNumber"
                                CaretBrush="White"
                                Style="{StaticResource TextBoxOfInput}"
                                MaxLength="9" 
                                AcceptsReturn="False">
                            </TextBox>

                            <!-- DATE OF BIRTH -->
                            <TextBlock
                                Grid.Row="4"
                                Text="Ημερομηνία Γέννησης:dd/mm/yyyy"
                                Style="{StaticResource TextBlockOfInput}">
                            </TextBlock>
                            <TextBox 
                                Grid.Row="5"
                                Name="inputDateOfBirth"
                                CaretBrush="White"
                                Style="{StaticResource TextBoxOfInput}"
                                MaxLength="9" 
                                AcceptsReturn="False">
                            </TextBox>

                        </Grid>




                    </Grid>


                </Grid>

                <Grid Grid.Column="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="auto" />
                        <RowDefinition Height="auto" />
                    </Grid.RowDefinitions>

                    <!-- TITLE -->
                    <Grid Grid.Row="0">
                        <TextBlock 
                            Text="Επεξεργασία Ακαδημαϊκών Στοιχείων" 
                            Foreground="White" 
                            FontSize="20" 
                            FontWeight="ExtraBold" 
                            FontFamily="Manrope">
                        </TextBlock>
                    </Grid>


                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>


                        <Grid Grid.Column="0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="auto" />
                                <RowDefinition Height="auto" />
                                <RowDefinition Height="auto" />
                                <RowDefinition Height="auto" />
                                <RowDefinition Height="auto" />
                                <RowDefinition Height="auto" />
                                <RowDefinition Height="auto" />
                                <RowDefinition Height="auto" />
                                <RowDefinition Height="auto" />
                                <RowDefinition Height="auto" />
                            </Grid.RowDefinitions>

                            <!-- EMAIL ADDRESS -->
                            <TextBlock
                                Grid.Row="0"
                                Text="Ακαδημαϊκό Ηλεκτρ. Ταχυδρομείο"
                                Style="{StaticResource TextBlockOfInput}">
                            </TextBlock>
                            <TextBox 
                                Grid.Row="1"
                                Name="inputEmail"
                                CaretBrush="White"
                                Style="{StaticResource TextBoxOfInput}"
                                MaxLength="20" 
                                AcceptsReturn="False">
                            </TextBox>

                            <!-- DEPARTMENT -->
                            <TextBlock
                                Grid.Row="4"
                                Text="Τμήμα:"
                                Style="{StaticResource TextBlockOfInput}">
                            </TextBlock>
                            <TextBox 
                                Grid.Row="5"
                                Name="inputDepartment"
                                IsEnabled="False"
                                Style="{StaticResource TextBoxOfInput}"
                                MaxLength="20" 
                                AcceptsReturn="False">
                            </TextBox>

                            <!-- YEAR OF ENTRY -->
                            <TextBlock
                                Grid.Row="6"
                                Text="Χρονιά Εισαγωγής:"
                                Style="{StaticResource TextBlockOfInput}">
                            </TextBlock>
                            <TextBox 
                                Grid.Row="7"
                                Name="inputYearOfEntry"
                                IsEnabled="False"
                                Style="{StaticResource TextBoxOfInput}"
                                MaxLength="20" 
                                AcceptsReturn="False">
                            </TextBox>

                        </Grid>


                        <Grid Grid.Column="1">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="auto" />
                                <RowDefinition Height="auto" />
                                <RowDefinition Height="auto" />
                                <RowDefinition Height="auto" />
                            </Grid.RowDefinitions>

                            <!-- AEM -->
                            <TextBlock
                                Grid.Row="0"
                                Text="ΑΕΜ:"
                                Style="{StaticResource TextBlockOfInput}">
                            </TextBlock>
                            <TextBox 
                                Grid.Row="1"
                                Name="inputAEM"
                                IsEnabled="False"
                                Style="{StaticResource TextBoxOfInput}"
                                MaxLength="20" 
                                AcceptsReturn="False">
                            </TextBox>

                            <!-- SEMESTER -->
                            <TextBlock
                                Grid.Row="2"
                                Text="Εξάμηνο (Τρέχον):"
                                Style="{StaticResource TextBlockOfInput}">
                            </TextBlock>
                            <TextBox 
                                Grid.Row="3"
                                Name="inputSemester"
                                CaretBrush="White"
                                Style="{StaticResource TextBoxOfInput}"
                                MaxLength="20" 
                                AcceptsReturn="False">
                            </TextBox>

                        </Grid>
                    </Grid>


                </Grid>
            </Grid>



            <!-- BUTTONS -->
            <Grid Grid.Row="2">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0">
                    
                    <Border Grid.Column="2"
                        BorderBrush="{StaticResource ColorSuccess}" 
                        BorderThickness="2" 
                        CornerRadius="6" 
                        Padding="26 32 70 32">

                        <Grid Grid.Column="1" Background="Transparent">
                            <StackPanel Orientation="Vertical" HorizontalAlignment="Left" Margin="0">

                                <TextBlock Text="Αποθήκευση Αλλαγών"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource ColorLight}">
                                </TextBlock>

                                <TextBlock Text="Αποθήκευση μπορεί να γίνει μόνο με αλλαγές στις πληροφορίες σας."
                                   Margin="0 4 0 0"
                                   FontSize="12"
                                   FontWeight="Light"
                                   Foreground="{StaticResource ColorLight}">
                                </TextBlock>

                                <Button Content="Αποθήκευση"
                    Click="SaveChangesButton_Click"
                    Style="{StaticResource SaveChangesButton}"
                    Margin="0 10 0 0">
                                </Button>

                            </StackPanel>
                        </Grid>

                    </Border>

                </Grid>


                <Grid Grid.Column="2">
                    <Border Grid.Column="2"
                        BorderBrush="{StaticResource ColorDanger}" 
                        BorderThickness="2" 
                        CornerRadius="6" 
                        Padding="26 32 70 32">

                        <Grid Grid.Column="1" Background="Transparent">
                            <StackPanel Orientation="Vertical" HorizontalAlignment="Left" Margin="0">

                                <TextBlock Text="Διαγραφή λογαρισμού"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource ColorLight}">
                                </TextBlock>

                                <TextBlock Text="* Η οριστική διαγραφή του λογαριασμού σας είναι μη αναστρέψιμη."
                                   Margin="0 4 0 0"
                                   FontSize="12"
                                   FontWeight="Light"
                                   Foreground="{StaticResource ColorLight}">
                                </TextBlock>

                                <Button Content="Διαγραφή Λογαριασμού"
                                    Click="DeleteAccountButton_Click"
                                    Style="{StaticResource DeleteAccountButton}"
                                    Margin="0 10 0 0">
                                </Button>

                            </StackPanel>
                        </Grid>

                    </Border>
                </Grid>
                
            </Grid>


        </Grid>
    </Border>

</UserControl>
