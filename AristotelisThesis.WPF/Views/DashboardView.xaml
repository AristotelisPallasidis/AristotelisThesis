<UserControl x:Class="AristotelisThesis.WPF.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:AristotelisThesis.WPF.Views"
             
             xmlns:controls="clr-namespace:AristotelisThesis.WPF.Controls"

             mc:Ignorable="d" 
             d:DesignWidth="1920" d:DesignHeight="1080">


    <Border Background="#1D1C1D" BorderBrush="Transparent" BorderThickness="1,1,1,1" CornerRadius="24,24,24,24">
        <Grid Margin="20">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- ////////////////////////////// -->
            <!-- LEFT SIDE -->
            <!-- ////////////////////////////// -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Welcome & Introduction -->
                <Grid Grid.Row="0" HorizontalAlignment="Stretch">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="auto" />
                        <RowDefinition Height="auto" />
                        <RowDefinition Height="auto" />
                    </Grid.RowDefinitions>

                    <TextBlock 
                        Text="Καλωσορίσατε"
                        Grid.Row="0"
                        Foreground="{StaticResource ColorLight}" 
                        FontSize="35">
                    </TextBlock>
                    
                    <TextBlock 
                        Text="{Binding StudentFullName}"
                        Grid.Row="1"
                        Foreground="{StaticResource ColorLight}"
                        FontSize="35" 
                        FontWeight="ExtraBold">
                    </TextBlock>

                    <TextBlock 
                        Grid.Row="2" 
                        Foreground="{StaticResource ColorLight}"
                        FontSize="16" 
                        Margin="0 10 0 0">
                            <Run Text="ΔΠΘ -" />
                            <Run Text="{Binding StudentLevelAndGender, Mode=OneWay}" />
                            <Run Text="{Binding StudentDepartment, Mode=OneWay}" />
                        </TextBlock>


                </Grid>


                <Grid Grid.Row="1" Margin="0 20 10 0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    

                    <Grid Grid.Column="0" Margin="0 0 10 0">
                        <Border
                            Grid.Row="0"
                            Background="#E6E6E6"
                            Padding="20"
                            CornerRadius="8 8 8 8"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Stretch">
                            <StackPanel Orientation="Vertical">

                                <TextBlock 
                                    Text="Προφιλ"
                                    FontSize="22"
                                    FontWeight="Bold"
                                    Foreground="{StaticResource ColorDark}">
                                </TextBlock>
                                <Separator Width="auto" Margin="0 10"/>

                                <TextBlock 
                                    TextWrapping="Wrap" 
                                    Text="Οι εσωτερικες ρυθμισης σας δινουν την δυνατοτητα να ενημερωσετε ορισμενα απο τα προσωπικα σας στοιχεια τα οποια εισαγαγατε κατα την εγγραφη σας στην πλατφορμα του πανεπιστημιου."
                                    Foreground="{StaticResource ColorDark}"
                                    FontSize="16">
                                </TextBlock>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <Grid Grid.Column="1" Margin="10 0 0 0">
                        <Border
                            Grid.Row="1"
                            Background="#E6E6E6"
                            Padding="20"
                            CornerRadius="8 8 8 8"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Stretch">
                            <StackPanel Orientation="Vertical">
                                <TextBlock 
                                    Text="Ρυθμίσεις" 
                                    FontSize="22"
                                    FontWeight="Bold"
                                    Foreground="{StaticResource ColorDark}">
                                </TextBlock>
                                <Separator Width="auto" Margin="0 10"/>
                                <TextBlock 
                                    TextWrapping="Wrap" 
                                    Text="Οι εσωτερικες ρυθμισης σας δινουν την δυνατοτητα να ενημερωσετε ορισμενα απο τα προσωπικα σας στοιχεια τα οποια εισαγαγατε κατα την εγγραφη σας στην πλατφορμα του πανεπιστημιου."
                                    Foreground="{StaticResource ColorDark}"
                                    FontSize="16">
                                </TextBlock>
                            </StackPanel>
                        </Border>
                    </Grid>

                </Grid>


                <Grid Grid.Row="2" Margin="0 20 10 0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Grid Grid.Column="0" Margin="0 0 10 0">
                        <Border
                            Grid.Row="0"
                            Background="#E6E6E6"
                            Padding="20"
                            CornerRadius="8 8 8 8"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Stretch">
                            <StackPanel Orientation="Vertical">
                                <TextBlock 
                                    Text="Αναγνώριση Παλάμης" 
                                    FontSize="22"
                                    FontWeight="Bold"
                                    Foreground="{StaticResource ColorDark}">
                                </TextBlock>
                                <Separator Width="auto" Margin="0 10"/>
                                <TextBlock 
                                    TextWrapping="Wrap" 
                                    Text="Οι εσωτερικες ρυθμισης σας δινουν την δυνατοτητα να ενημερωσετε ορισμενα απο τα προσωπικα σας στοιχεια τα οποια εισαγαγατε κατα την εγγραφη σας στην πλατφορμα του πανεπιστημιου."
                                    Foreground="{StaticResource ColorDark}"
                                    FontSize="16">
                                </TextBlock>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <Grid Grid.Column="1" Margin="10 0 0 0">
                        <Border
                            Grid.Row="1"
                            Background="#E6E6E6"
                            Padding="10"
                            CornerRadius="8 8 8 8"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Stretch">

                            <StackPanel Orientation="Vertical">
                                <TextBlock 
                                    Text="Αναγνώριση Προσώπου" 
                                    FontSize="22"
                                    FontWeight="Bold"
                                    Foreground="{StaticResource ColorDark}">
                                </TextBlock>
                                <Separator Width="auto" Margin="0 10"/>
                                <TextBlock 
                                    TextWrapping="Wrap" 
                                    Text="Οι εσωτερικες ρυθμισης σας δινουν την δυνατοτητα να ενημερωσετε ορισμενα απο τα προσωπικα σας στοιχεια τα οποια εισαγαγατε κατα την εγγραφη σας στην πλατφορμα του πανεπιστημιου."
                                    Foreground="{StaticResource ColorDark}"
                                    FontSize="16">
                                </TextBlock>
                            </StackPanel>
                        </Border>
                    </Grid>

                </Grid>

            </Grid>

            
            <!-- ////////////////////////////// -->
            <!-- RIGHT SIDE -->
            <!-- ////////////////////////////// -->
            <Grid Grid.Column="1">
                
                <Grid.RowDefinitions>
                    <RowDefinition Height="auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="10 0 0 0">
                    <Border
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch"
                        Background="#E6E6E6"
                        Padding="42"
                        CornerRadius="8 8 8 8">

                            <controls:ClockCard Width="260" FontSize="34"/>
                            
                    </Border>
                </Grid>

                <Grid Grid.Row="1" Margin="10 15 0 0">
                    <Border
                        Grid.Row="1"
                        Background="#E6E6E6"
                        Padding="20"
                        CornerRadius="8 8 8 8"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch">
                        
                        <StackPanel Orientation="Vertical">
                            <TextBlock 
                                Text="Στατιστικά Στοιχεία" 
                                FontSize="22"
                                FontWeight="Bold"
                                Foreground="{StaticResource ColorDark}">
                            </TextBlock>
                            
                            <Separator Width="auto" Margin="0 10"/>

                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="auto" />
                                    <!-- This row will stretch -->
                                </Grid.RowDefinitions>

                                <TextBlock 
                                    Grid.Row="0"
                                    Text="Εβδομαδιαίο σύνολο ώρων σύνδεσης" 
                                    FontSize="20">
                                </TextBlock>

                                <TextBlock 
                                    Grid.Row="2"
                                    Text="64" 
                                    Foreground="{StaticResource ColorSuccess}" 
                                    FontSize="120"
                                    FontWeight="Black"
                                    HorizontalAlignment="Right" 
                                    VerticalAlignment="Stretch"
                                    Margin="0 200 10 10"> <!-- Margin ensures some space from edges -->
                                </TextBlock>
                            </Grid>

                        </StackPanel>

                    </Border>
                    
                </Grid>

            </Grid>

        </Grid>
    </Border>

</UserControl>
