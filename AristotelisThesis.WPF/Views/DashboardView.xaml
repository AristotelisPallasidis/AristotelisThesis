<UserControl x:Class="AristotelisThesis.WPF.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:AristotelisThesis.WPF.Views"
             
             xmlns:controls="clr-namespace:AristotelisThesis.WPF.Controls"

             mc:Ignorable="d" 
             d:DesignWidth="1920" d:DesignHeight="1080">


    <Border Background="#1D1C1D" BorderBrush="Transparent" BorderThickness="1,1,1,1" CornerRadius="24,24,24,24">
        <Grid Margin="20">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Shared rows: both columns line up on the same two card rows. -->
            <Grid.RowDefinitions>
                <RowDefinition Height="auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- ////////////////////////////// -->
            <!-- LEFT SIDE -->
            <!-- ////////////////////////////// -->

            <!-- Welcome & Introduction -->
            <Grid Grid.Row="0" Grid.Column="0" HorizontalAlignment="Stretch">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="auto" />
                        <RowDefinition Height="auto" />
                        <RowDefinition Height="auto" />
                    </Grid.RowDefinitions>

                    <TextBlock 
                        Text="Καλωσορίσατε"
                        Grid.Row="0"
                        Foreground="{StaticResource ColorLight}" 
                        FontSize="35">
                    </TextBlock>
                    
                    <TextBlock 
                        Text="{Binding StudentFullName}"
                        Grid.Row="1"
                        Foreground="{StaticResource ColorLight}"
                        FontSize="35" 
                        FontWeight="ExtraBold">
                    </TextBlock>

                    <TextBlock 
                        Grid.Row="2" 
                        Foreground="{StaticResource ColorLight}"
                        FontSize="16" 
                        Margin="0 10 0 0">
                            <Run Text="ΔΠΘ -" />
                            <Run Text="{Binding StudentLevelAndGender, Mode=OneWay}" />
                            <Run Text="{Binding StudentDepartment, Mode=OneWay}" />
                        </TextBlock>


                </Grid>


                <Grid Grid.Row="1" Grid.Column="0" Margin="0 20 10 0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    

                    <Grid Grid.Column="0" Margin="0 0 10 0">
                        <Border
                            Grid.Row="0"
                            Background="#E6E6E6"
                            Padding="20"
                            CornerRadius="8 8 8 8"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Stretch">
                            <StackPanel Orientation="Vertical">

                                <TextBlock 
                                    Text="Προφιλ"
                                    FontSize="22"
                                    FontWeight="Bold"
                                    Foreground="{StaticResource ColorDark}">
                                </TextBlock>
                                <Separator Width="auto" Margin="0 10"/>

                                <TextBlock 
                                    TextWrapping="Wrap" 
                                    Text="Οι εσωτερικες ρυθμισης σας δινουν την δυνατοτητα να ενημερωσετε ορισμενα απο τα προσωπικα σας στοιχεια τα οποια εισαγαγατε κατα την εγγραφη σας στην πλατφορμα του πανεπιστημιου."
                                    Foreground="{StaticResource ColorDark}"
                                    FontSize="16">
                                </TextBlock>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <Grid Grid.Column="1" Margin="10 0 0 0">
                        <Border
                            Grid.Row="1"
                            Background="#E6E6E6"
                            Padding="20"
                            CornerRadius="8 8 8 8"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Stretch">
                            <StackPanel Orientation="Vertical">
                                <TextBlock 
                                    Text="Ρυθμίσεις" 
                                    FontSize="22"
                                    FontWeight="Bold"
                                    Foreground="{StaticResource ColorDark}">
                                </TextBlock>
                                <Separator Width="auto" Margin="0 10"/>
                                <TextBlock 
                                    TextWrapping="Wrap" 
                                    Text="Οι εσωτερικες ρυθμισης σας δινουν την δυνατοτητα να ενημερωσετε ορισμενα απο τα προσωπικα σας στοιχεια τα οποια εισαγαγατε κατα την εγγραφη σας στην πλατφορμα του πανεπιστημιου."
                                    Foreground="{StaticResource ColorDark}"
                                    FontSize="16">
                                </TextBlock>
                            </StackPanel>
                        </Border>
                    </Grid>

                </Grid>


                <Grid Grid.Row="2" Grid.Column="0" Margin="0 20 10 0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Grid Grid.Column="0" Margin="0 0 10 0">
                        <Border
                            Grid.Row="0"
                            Background="#E6E6E6"
                            Padding="20"
                            CornerRadius="8 8 8 8"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Stretch">
                            <StackPanel Orientation="Vertical">
                                <TextBlock 
                                    Text="Αναγνώριση Παλάμης" 
                                    FontSize="22"
                                    FontWeight="Bold"
                                    Foreground="{StaticResource ColorDark}">
                                </TextBlock>
                                <Separator Width="auto" Margin="0 10"/>
                                <TextBlock 
                                    TextWrapping="Wrap" 
                                    Text="Οι εσωτερικες ρυθμισης σας δινουν την δυνατοτητα να ενημερωσετε ορισμενα απο τα προσωπικα σας στοιχεια τα οποια εισαγαγατε κατα την εγγραφη σας στην πλατφορμα του πανεπιστημιου."
                                    Foreground="{StaticResource ColorDark}"
                                    FontSize="16">
                                </TextBlock>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <Grid Grid.Column="1" Margin="10 0 0 0">
                        <Border
                            Grid.Row="1"
                            Background="#E6E6E6"
                            Padding="10"
                            CornerRadius="8 8 8 8"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Stretch">

                            <StackPanel Orientation="Vertical">
                                <TextBlock 
                                    Text="Αναγνώριση Προσώπου" 
                                    FontSize="22"
                                    FontWeight="Bold"
                                    Foreground="{StaticResource ColorDark}">
                                </TextBlock>
                                <Separator Width="auto" Margin="0 10"/>
                                <TextBlock 
                                    TextWrapping="Wrap" 
                                    Text="Οι εσωτερικες ρυθμισης σας δινουν την δυνατοτητα να ενημερωσετε ορισμενα απο τα προσωπικα σας στοιχεια τα οποια εισαγαγατε κατα την εγγραφη σας στην πλατφορμα του πανεπιστημιου."
                                    Foreground="{StaticResource ColorDark}"
                                    FontSize="16">
                                </TextBlock>
                            </StackPanel>
                        </Border>
                    </Grid>

                </Grid>

            <!-- ////////////////////////////// -->
            <!-- RIGHT SIDE -->
            <!-- ////////////////////////////// -->

            <!-- Spans both card rows, so it starts and ends level with the cards on the left. -->
            <Grid Grid.Row="1" Grid.RowSpan="2" Grid.Column="1" Margin="10 20 0 0">
                <Border
                    Background="#E6E6E6"
                    Padding="20"
                    CornerRadius="8 8 8 8"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch">

                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="auto" />
                            <RowDefinition Height="auto" />
                            <RowDefinition Height="auto" />
                            <RowDefinition Height="*" />
                            <!-- The percentage takes whatever height is left -->
                        </Grid.RowDefinitions>

                        <TextBlock
                            Grid.Row="0"
                            Text="Στατιστικά Στοιχεία"
                            FontSize="22"
                            FontWeight="Bold"
                            Foreground="{StaticResource ColorDark}">
                        </TextBlock>

                        <Separator Grid.Row="1" Width="auto" Margin="0 10"/>

                        <TextBlock
                            Grid.Row="2"
                            Text="Εβδομαδιαίο ποσοστό παρουσίας"
                            FontSize="20">
                        </TextBlock>

                        <TextBlock
                            Grid.Row="3"
                            Text="{Binding WeeklyAttendancePercentage}"
                            Foreground="{StaticResource ColorSuccess}"
                            FontSize="120"
                            FontWeight="Black"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Bottom"
                            Margin="0 10 10 10"> <!-- Margin ensures some space from edges -->
                        </TextBlock>
                    </Grid>

                </Border>

            </Grid>

        </Grid>
    </Border>

</UserControl>
