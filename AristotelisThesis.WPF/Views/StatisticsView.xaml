<UserControl x:Class="AristotelisThesis.WPF.Views.StatisticsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:AristotelisThesis.WPF.Views"

            xmlns:controls="clr-namespace:AristotelisThesis.WPF.Controls"

             mc:Ignorable="d" 
             d:DesignWidth="1920" d:DesignHeight="1080">



    <Border Background="#1D1C1D" BorderBrush="Transparent" BorderThickness="1,1,1,1" CornerRadius="24,24,24,24">
        <Grid Margin="20">
    

            <Grid.RowDefinitions>
                <RowDefinition Height="auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- ROW TITLE -->
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" Grid.Column="0">
                    <!-- Recolour the icon to white using its alpha as an opacity mask -->
                    <Rectangle Width="30" Height="30" Margin="0 0 10 0" Fill="White">
                        <Rectangle.OpacityMask>
                            <ImageBrush ImageSource="C:\Users\Aristotelis\Desktop\test2\AristotelisThesis\AristotelisThesis.WPF\Assets\Icons\ChartIconSolid.png" />
                        </Rectangle.OpacityMask>
                    </Rectangle>
                    <TextBlock 
                        Text="Στατιστικά" 
                        Grid.Column="0"
                        Style="{StaticResource PageTitle}">
                    </TextBlock>
                </StackPanel>

                <!-- Connection-duration clock now lives in the shared navigation bar -->

            </Grid>

            <!-- ROW CONTENT -->
            <Grid Grid.Row="1" Margin="0 14 0 0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>


                <Grid Grid.Column="0" Margin="0 0 5 0">
                    <!-- WEEK ATTENDANCE GRAPH -->
                    <controls:WeeklyAttendanceGraph Statistics="{Binding Statistics}" />
                </Grid>

                <Grid Grid.Column="1" Margin="5 0 0 0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Grid Grid.Column="0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="auto" />
                            <RowDefinition Height="auto" />
                            <RowDefinition Height="auto" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="0 0 5 5">
                            <controls:TotalHoursWeekCard Statistics="{Binding Statistics}" />
                        </Grid>
                        <Grid Grid.Row="1" Margin="0 5 5 5">
                            <controls:WeeklyAverageActiveTimeCard Statistics="{Binding Statistics}" />
                        </Grid>

                        <Grid Grid.Row="2" Margin="0 5 5 0">
                            <controls:AttendanceMonthPercentageCard Statistics="{Binding Statistics}" />
                        </Grid>
                        
                    </Grid>
                    
                    <Grid Grid.Column="1">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="auto" />
                            <RowDefinition Height="auto" />
                            <RowDefinition Height="auto" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="5 0 0 5">
                            <controls:DaysAttendedThisWeekCard Statistics="{Binding Statistics}" />
                        </Grid>
                        <Grid Grid.Row="1" Margin="5 5 0 5">
                            <controls:TodaysCheckInTimeCard Statistics="{Binding Statistics}" />
                        </Grid>

                        <Grid Grid.Row="2" Margin="5 5 0 5">
                            <controls:StreakTrackerCard Statistics="{Binding Statistics}" />
                        </Grid>
                    </Grid>
                </Grid>
                
            </Grid>


        </Grid>
    </Border>

</UserControl>
