<UserControl x:Class="AristotelisThesis.WPF.Views.ProfileView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:AristotelisThesis.WPF.Views"
             
             xmlns:nav="clr-namespace:AristotelisThesis.WPF.State.Navigators"
             xmlns:controls="clr-namespace:AristotelisThesis.WPF.Controls"

             xmlns:converters="clr-namespace:AristotelisThesis.WPF.Converters"

             mc:Ignorable="d" 
             d:DesignHeight="850" d:DesignWidth="1440">

    <UserControl.Resources>
        <converters:EqualValueToParameterConverter x:Key="EqualValueToParameterConverter" />
    </UserControl.Resources>


    <Border Background="#1D1C1D" BorderBrush="Black" BorderThickness="1 1 1 1" CornerRadius="24 24 24 24">
        <Grid Margin="20">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>


            <!-- ROW TITLE -->
            <Grid Grid.Row="0">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="auto" />
                </Grid.ColumnDefinitions>

                <!-- TITLE SCREEN-->
                <StackPanel Orientation="Horizontal" Grid.Column="0">
                    <Image Source="C:\Users\Aristotelis\Desktop\repos\AristotelisThesis\AristotelisThesis.WPF\Assets\Icons\UserIconSolid.png" Width="30" Height="30" Margin="0 0 10 0"></Image>
                    <TextBlock 
                        Text="Προφιλ" 
                        Grid.Column="0"
                        Style="{StaticResource PageTitle}">
                    </TextBlock>
                </StackPanel>

                <!-- CLOCK CARD -->
                <Grid Grid.Column="2">
                    <controls:ClockCard Width="280"/>
                    <!-- <card:ClockCard String Format {Binding Gender display end } {Binding nowTime - start }-->
                </Grid>

            </Grid>

            <Grid Grid.Row="1">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0" VerticalAlignment="Center">

                    <StackPanel Orientation="Vertical" HorizontalAlignment="Center"  VerticalAlignment="Center">

                        <TextBlock 
                            Name="txtName"
                            Text="Name" 
                            Margin="0 8 0 0" 
                            HorizontalAlignment="Left"
                            Foreground="White" 
                            FontSize="36" 
                            FontWeight="ExtraBold">
                        </TextBlock>
                        <TextBlock 
                            Name="txtSurname"
                            Text="Surname"
                            HorizontalAlignment="Left"
                            Foreground="White"
                            FontSize="36" 
                            FontWeight="ExtraBold">
                        </TextBlock>
                        <TextBlock 
                            Name="txtDepartment"
                            Text="Τμήμα - Computer Science"
                            Margin="0 20 0 0"  
                            HorizontalAlignment="Left" 
                            Foreground="White" 
                            FontSize="18">
                        </TextBlock>
                        <TextBlock 
                            Text="AEM - 0000" 
                            Name="txtAEM"
                            Margin="0 8 0 0"  
                            HorizontalAlignment="Left" 
                            Foreground="White" 
                            FontSize="18">
                        </TextBlock>
                        <TextBlock 
                            Text="Εξάμηνο - 00" 
                            Name="txtSemester"
                            Margin="0 8 0 0"  
                            HorizontalAlignment="Left" 
                            Foreground="White" 
                            FontSize="18">
                        </TextBlock>
                        <TextBlock 
                            Text="Έτος Εισαγωγής - 2024"
                            Name="txtYearOfEntry"
                            Margin="0 8 0 0"  
                            HorizontalAlignment="Left" 
                            Foreground="White" 
                            FontSize="18">
                        </TextBlock>
                        <TextBlock 
                            Text="Email - joe.doe@example.com"
                            Name="txtEmail"
                            Margin="0 8 0 0"  
                            HorizontalAlignment="Left" 
                            Foreground="White" 
                            FontSize="18">
                        </TextBlock>

                    </StackPanel>
                </Grid>


                <Grid Grid.Column="1" Margin="0 0 80 0" HorizontalAlignment="Left" VerticalAlignment="Center">

                    <Image 
                        Source="C:\Users\Aristotelis\Desktop\repos\AristotelisThesis\AristotelisThesis.WPF\Assets\01.jpeg" 
                        Width="300" 
                        Height="300" 
                        Margin="0 0 50 0">
                    </Image>
                </Grid>

            </Grid>

        </Grid>
    </Border>


</UserControl>
