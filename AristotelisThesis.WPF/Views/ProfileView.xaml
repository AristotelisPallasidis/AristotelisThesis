<UserControl x:Class="AristotelisThesis.WPF.Views.ProfileView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:AristotelisThesis.WPF.Views"
             
             xmlns:nav="clr-namespace:AristotelisThesis.WPF.State.Navigators"
             xmlns:controls="clr-namespace:AristotelisThesis.WPF.Controls"

             xmlns:converters="clr-namespace:AristotelisThesis.WPF.Converters"

             mc:Ignorable="d" 
             d:DesignWidth="1920" d:DesignHeight="1080">

    <UserControl.Resources>
        <converters:EqualValueToParameterConverter x:Key="EqualValueToParameterConverter" />
    </UserControl.Resources>


    <Border Background="#1D1C1D" BorderBrush="Black" BorderThickness="1 1 1 1" CornerRadius="24 24 24 24">
        <Grid Margin="20">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>


            <Grid Grid.Row="0">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" Grid.Column="0">
                    <Image Source="C:\Users\Aristotelis\Desktop\test2\AristotelisThesis\AristotelisThesis.WPF\Assets\Icons\UserIconSolid.png" Width="30" Height="30" Margin="0 0 10 0"></Image>
                    <TextBlock 
                        Text="Προφιλ" 
                        Grid.Column="0"
                        Style="{StaticResource PageTitle}">
                    </TextBlock>
                </StackPanel>


            </Grid>

            <Grid Grid.Row="1">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                
                <Grid Grid.Column="0" Margin="0 0 80 0" HorizontalAlignment="Right" VerticalAlignment="Center">

                    <Ellipse Width="300" Height="300" Margin="0 0 50 0">
                        <Ellipse.Fill>
                            <ImageBrush ImageSource="C:\Users\Aristotelis\Desktop\test2\AristotelisThesis\AristotelisThesis.WPF\Assets\01.jpeg"/>
                        </Ellipse.Fill>
                    </Ellipse>

                    <Ellipse Width="300" Height="300" Margin="0 0 50 0" Stroke="White" StrokeThickness="3">
                        <Ellipse.Effect>
                            <DropShadowEffect Color="Black" BlurRadius="15" ShadowDepth="5"/>
                        </Ellipse.Effect>
                        <Ellipse.Fill>
                            <ImageBrush ImageSource="C:\Users\Aristotelis\Desktop\test2\AristotelisThesis\AristotelisThesis.WPF\Assets\01.jpeg"/>
                        </Ellipse.Fill>
                    </Ellipse>

                </Grid>

                <Grid Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Left">

                    <StackPanel Orientation="Vertical" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="20">

                        <StackPanel Orientation="Vertical" HorizontalAlignment="Left">

                            <!-- AEM -->
                            <TextBlock 
                                Text="{Binding StudentAEM}" 
                                FontWeight="ExtraBold"
                                Opacity="0.6"
                                Foreground="#f5f5f5" 
                                FontSize="16">
                            </TextBlock>

                            <!-- Name and Surname -->
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                                <TextBlock 
                                    Text="{Binding StudentName}" 
                                    Foreground="{StaticResource ColorLight}"
                                    FontSize="36" 
                                    FontWeight="ExtraLight"/>
                                <TextBlock 
                                    Text="{Binding StudentSurname}"
                                    Foreground="{StaticResource ColorLight}"
                                    FontSize="36" 
                                    FontWeight="ExtraBold"
                                    Margin="10 0"/>
                            </StackPanel>
                        </StackPanel>

                        <!-- Separator -->
                        <Separator Width="auto" Margin="0 20"/>

                        <!-- Department -->
                        <StackPanel Orientation="Horizontal">
                            <Image Source="https://img.icons8.com/ios-filled/50/FFFFFF/graduation-cap.png" Width="20" Height="20" Margin="0 0 10 0"/>
                            <TextBlock 
                                Text="{Binding StudentDepartment}" 
                                Foreground="{StaticResource ColorLight}"
                                FontSize="18" 
                                FontWeight="Regular"/>
                        </StackPanel>

                        <!-- Semester -->
                        <StackPanel Orientation="Horizontal" Margin="0 12 0 0">
                            <Image Source="https://img.icons8.com/ios-filled/50/FFFFFF/calendar.png" Width="20" Height="20" Margin="0 0 10 0"/>
                            <TextBlock 
                                Text="{Binding StudentSemester}" 
                                Foreground="{StaticResource ColorLight}"
                                FontSize="18"/>
                        </StackPanel>

                        <!-- Year of Entry -->
                        <StackPanel Orientation="Horizontal" Margin="0 12 0 0">
                            <Image Source="https://img.icons8.com/ios-filled/50/FFFFFF/time-machine.png" Width="20" Height="20" Margin="0 0 10 0"/>
                            <TextBlock 
                                Text="{Binding StudentYearOfEntry}"
                                Foreground="{StaticResource ColorLight}"
                                FontSize="18"/>
                        </StackPanel>

                        <!-- Email -->
                        <StackPanel Orientation="Horizontal" Margin="0 12 0 0">
                            <Image Source="https://img.icons8.com/ios-filled/50/FFFFFF/new-post.png" Width="20" Height="20" Margin="0 0 10 0"/>
                            <TextBlock 
                                Text="{Binding StudentAcademicEmail}" 
                                Foreground="{StaticResource ColorLight}"
                                FontSize="18"/>
                        </StackPanel>

                    </StackPanel>

                </Grid>

            </Grid>

        </Grid>
    </Border>


</UserControl>