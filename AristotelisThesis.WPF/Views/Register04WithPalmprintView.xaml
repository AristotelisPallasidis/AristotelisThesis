<UserControl x:Class="AristotelisThesis.WPF.Views.Register04WithPalmprintView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:AristotelisThesis.WPF.Views"
             xmlns:controls="clr-namespace:AristotelisThesis.WPF.Controls"
             mc:Ignorable="d"
             d:DesignWidth="1920" d:DesignHeight="1080"
             Background="#1D1C1D"
             Loaded="Window_Loaded">

    <Grid Margin="40">

        <Grid.RowDefinitions>
            <RowDefinition Height="auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="auto" />
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0" Grid.Row="0" Margin="0 20 0 10">
            <TextBlock
                Text="Εγγραφή μέσω Παλάμης"
                Style="{StaticResource PageTitle}">
            </TextBlock>
        </Grid>

        <!-- Camera feed -->
        <Grid Grid.Column="0" Grid.Row="1" Margin="0 10 0 0">
            <Grid.RowDefinitions>
                <RowDefinition Height="auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="auto" />
            </Grid.RowDefinitions>

            <TextBlock
                Grid.Row="0"
                Text="Κάμερα"
                FontFamily="Manrope"
                FontSize="24"
                FontWeight="Bold"
                Foreground="White"
                Margin="0 0 0 6">
            </TextBlock>

            <Grid Grid.Row="1" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                <Image x:Name="CameraFeed" Stretch="Fill" />
                <controls:PalmGuideOverlay />
            </Grid>

            <TextBlock
                Grid.Row="2"
                Foreground="White"
                FontSize="16"
                Margin="0 8 0 0"
                Text="{Binding StatusText}" />
        </Grid>

        <!-- Camera controls -->
        <Grid Grid.Column="1" Grid.Row="1" Margin="12 0 0 0">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="auto" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Orientation="Vertical" HorizontalAlignment="Left">
                <StackPanel Orientation="Horizontal">
                    <TextBlock
                        Text="Διαθέσιμες Κάμερες"
                        FontFamily="Manrope"
                        FontSize="24"
                        FontWeight="Bold"
                        Foreground="White"
                        Margin="0 10 0 6">
                    </TextBlock>
                    <Button
                        Content="Ανανέωση"
                        Click="RefreshButton_Click"
                        Margin="30 10 0 6"
                        Padding="18 6"
                        BorderThickness="0"
                        Background="White"
                        FontSize="16"
                        Cursor="Hand">
                    </Button>
                </StackPanel>

                <ListBox
                    x:Name="CameraList"
                    SelectionChanged="CameraList_SelectionChanged"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    Width="auto">
                </ListBox>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Grid.Row="1">
                <Button
                    Content="Βγάλε φωτογραφία"
                    Click="TakePhotoButton_Click"
                    FontSize="16"
                    Padding="18 6"
                    Margin="0 0 8 0"
                    BorderThickness="0"
                    Background="White"
                    Foreground="Black"
                    Cursor="Hand">
                </Button>
                <Button
                    Content="Επανάληψη"
                    Click="RepeatButton_Click"
                    FontSize="16"
                    Padding="14 6"
                    Margin="0"
                    BorderThickness="0"
                    Background="White"
                    Foreground="Black"
                    Cursor="Hand">
                </Button>
            </StackPanel>
        </Grid>

        <Grid Grid.Column="0" Grid.Row="2">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                <Button
                    Content="Επόμενο"
                    Command="{Binding GoToViewRegister05InstructionsForFaceCommand}"
                    Style="{StaticResource NextButton}"
                    Cursor="Hand">
                </Button>
                <Button
                    Content="Πίσω"
                    Command="{Binding GoToViewRegister03InstructionsForPalmprintCommand}"
                    Style="{StaticResource BackButton}"
                    Cursor="Hand">
                </Button>
            </StackPanel>
        </Grid>

    </Grid>
</UserControl>
