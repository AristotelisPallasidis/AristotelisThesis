<Window x:Class="AristotelisThesis.WPF.Windows.DeleteAccountWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:AristotelisThesis.WPF.Windows"
        mc:Ignorable="d"
        Title="ΔΠΘ - Διαγραφή Λογαριασμού" 
        Height="240" Width="520" 
        Background="{StaticResource ColorDark}" 
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Icon="C:\Users\Aristotelis\Desktop\repos\AristotelisThesis\AristotelisThesis.WPF\Assets\ico\DUTH-Logo.ico">
    
    
    <Grid Margin="20">

        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="auto" />
        </Grid.RowDefinitions>
        
        <Grid Grid.Row="0">
            <StackPanel Orientation="Vertical">
                <StackPanel Orientation="Horizontal" Margin="0 0 0 10">
                    <Image Source="C:\Users\Aristotelis\Desktop\repos\AristotelisThesis\AristotelisThesis.WPF\Assets\Icons\Trash-Icon.png" Width="20" Height="20" Margin="0 0 10 0"></Image>
                    <TextBlock Text="Οριστική Διαγραφή Λογαριασμού" Foreground="{StaticResource ColorLight}" FontSize="20" FontWeight="Bold"></TextBlock>
                </StackPanel>


                <TextBlock 
                    Text="Είστε σίγουροι οτι θέλετε να διαγράψετε τον λογαριασμό σας?" 
                    Foreground="{StaticResource ColorLight}" 
                    FontSize="14">
                </TextBlock>
                <TextBlock 
                    Text="Η διαγραφή του λογαρισμού σας ειναι μη αναστρέψιμη." 
                    Foreground="{StaticResource ColorLight}" 
                    FontSize="14">
                </TextBlock>
                <TextBlock 
                    Text="Όλα τα προσωπικά σας στοιχεία θα διαγραφούν." 
                    Foreground="{StaticResource ColorLight}" 
                    FontSize="14">
                </TextBlock>
            
            </StackPanel>
        </Grid>
        
        <Grid Grid.Row="1">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">

                <Button 
                    Content="Ναι" 
                    HorizontalAlignment="Left" 
                    VerticalAlignment="Top" 
                    Width="75"
                    Padding="10 4"
                    Foreground="White"
                    Cursor="Hand"
                    BorderThickness="0"
                    Background="{StaticResource ColorDanger}">
                </Button>
                    <!-- 
                    Click="AcceptButton_Click"
                    Click="DeclineButton_Click"
                    -->
                <Button 
                    Content="Ακύρωση" 
                    Click="DeclineButton_Click"
                    HorizontalAlignment="Left" 
                    Margin="10 0 0 0" 
                    VerticalAlignment="Top" 
                    Width="75"
                    Padding="10 4"
                    BorderThickness="0"
                    Cursor="Hand"
                    Background="{StaticResource ColorLight}">
                </Button>

            </StackPanel>
        </Grid>
    </Grid>
</Window>
