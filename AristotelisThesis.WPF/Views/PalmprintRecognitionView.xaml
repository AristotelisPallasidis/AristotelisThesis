<UserControl x:Class="AristotelisThesis.WPF.Views.PalmprintRecognitionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:AristotelisThesis.WPF.Views"
             
             xmlns:controls="clr-namespace:AristotelisThesis.WPF.Controls"

             mc:Ignorable="d" 
             d:DesignWidth="1920" d:DesignHeight="1080">

    <Border Background="#1D1C1D" BorderBrush="Transparent" BorderThickness="1,1,1,1" CornerRadius="24,24,24,24">
        <Grid Margin="20">

            <Grid.RowDefinitions>
                <RowDefinition Height="auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="auto" />
                </Grid.ColumnDefinitions>

                <!-- PAGE TITLE -->
                <StackPanel Orientation="Horizontal" Grid.Column="0">
                    <Image Source="C:\Users\Aristotelis\Desktop\test2\AristotelisThesis\AristotelisThesis.WPF\Assets\Icons\HandIconSolid.png" Width="30" Height="30" Margin="0 0 10 0"></Image>
                    <TextBlock 
                        Text="Αναγνώριση Παλάμης" 
                        Grid.Column="0"
                        Style="{StaticResource PageTitle}">
                    </TextBlock>
                </StackPanel>




            </Grid>

            <Grid Grid.Row="1" Margin="0 90 0 0" >

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Every enrolled palm image, four across. The cells divide the space
                     available, so the grid always fits the page instead of scrolling.
                     Uniform keeps the 4:3 captures whole, and centring the border makes
                     it hug the scaled image. -->
                <ItemsControl Grid.Column="0" Margin="0 0 20 0" ItemsSource="{Binding PalmImages}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="4" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="6" BorderBrush="#444" BorderThickness="1" CornerRadius="4"
                                    HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Image Source="{Binding}" Stretch="Uniform" />
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Grid Grid.Column="1" Margin="20 0 0 0">

                    <Grid.RowDefinitions>
                        <RowDefinition Height="auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <StackPanel>
                            <TextBlock
                                TextWrapping="Wrap"
                                VerticalAlignment="Top"
                                Foreground="{StaticResource ColorLight}"
                                FontSize="16"
                                FontWeight="Bold"
                                Margin="0,10,0,0">
                                Πληροφορίες
                            </TextBlock>
                            <TextBlock
                                TextWrapping="Wrap"
                                VerticalAlignment="Top"
                                Foreground="{StaticResource ColorLight}"
                                FontSize="16">
                                    Η αναγνώριση παλάμης είναι μια τεχνολογία βιομετρίας που χρησιμοποιεί τα μοναδικά μοτίβα στην παλάμη ενός ατόμου για να το αναγνωρίσει. Όπως και τα δακτυλικά αποτυπώματα, κάθε παλάμη έχει ένα μοναδικό σύνολο γραμμών, ραβδώσεων και πτυχών.
                            </TextBlock>

                            <!-- How it works section title -->
                            <TextBlock
                                TextWrapping="Wrap"
                                VerticalAlignment="Top"
                                Foreground="{StaticResource ColorLight}"
                                FontSize="16"
                                FontWeight="Bold"
                                Margin="0,10,0,0">
                                Πώς λειτουργεί:
                            </TextBlock>

                            <!-- List of steps -->
                            <StackPanel Margin="10,0,0,0">
                                <TextBlock
                                    TextWrapping="Wrap"
                                    VerticalAlignment="Top"
                                    Foreground="{StaticResource ColorLight}"
                                    FontSize="16">
                                    1. Λήψη της παλάμης: Μια κάμερα ή σαρωτής τραβάει μια φωτογραφία της παλάμης.

                                </TextBlock>
                                <TextBlock
                                    TextWrapping="Wrap"
                                    VerticalAlignment="Top"
                                    Foreground="{StaticResource ColorLight}"
                                    FontSize="16">
                                    2. Ανάλυση και Ταύτιση: Το σύστημα εξετάζει τα μοναδικά χαρακτηριστικά της παλάμης και τα συγκρίνει με ένα αποθηκευμένο πρότυπο (αν υπάρχει). Αν υπάρχει ταύτιση, επιβεβαιώνει την ταυτότητα.
                                </TextBlock>
                            </StackPanel>

                        </StackPanel>

                    </Grid>

                    <Border
                        Grid.Row="1"
                        VerticalAlignment="Bottom"
                        BorderBrush="{StaticResource ColorWarning}"
                        BorderThickness="2"
                        CornerRadius="6 6 6 6"
                        Padding="26 32 70 32">

                        <Grid Grid.Column="1" Background="Transparent">
                            <StackPanel Orientation="Vertical" HorizontalAlignment="Left">

                                <TextBlock
                                    Text="Ενημέρωση στοιχείων Παλάμης"
                                    FontSize="22"
                                    FontWeight="Bold"
                                    Foreground="White">
                                </TextBlock>

                                <TextBlock
                                    Text="* Η ενημέρωση εικόνων θα διαγράψη τις υπάρχουσες εικόνες"
                                    Margin="0 4 0 0"
                                    FontSize="12"
                                    FontWeight="Light"
                                    Foreground="{StaticResource ColorLight}">
                                </TextBlock>

                                <Button
                                    Content="Ενημέρωση στοιχείων"
                                    BorderThickness="0"
                                    Background="{StaticResource ColorWarning}"
                                    IsEnabled="False"
                                    FontSize="14"
                                    Padding="0 4"
                                    Margin="0 10 0 0"
                                    Cursor="Hand">
                                </Button>

                            </StackPanel>
                        </Grid>
                    </Border>

                </Grid>



            </Grid>


        </Grid>
    </Border>

</UserControl>
