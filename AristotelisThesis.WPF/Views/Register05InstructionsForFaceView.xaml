<UserControl x:Class="AristotelisThesis.WPF.Views.Register05InstructionsForFaceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:AristotelisThesis.WPF.Views"

             xmlns:controls="clr-namespace:AristotelisThesis.WPF.Controls"
             xmlns:vm="clr-namespace:AristotelisThesis.WPF.ViewModels"

             mc:Ignorable="d"
             d:DesignWidth="1920" d:DesignHeight="1080"
             Background="#1D1C1D">

    <UserControl.Resources>

        <!-- The instructions themselves. One entry per step; the numbering and the layout
             come from the template below, so adding or removing a step needs no other edit. -->
        <x:Array x:Key="Steps" Type="{x:Type vm:InstructionStep}">
            <vm:InstructionStep Number="1"
                Text="Βεβαιωθείτε ότι η κάμερα του υπολογιστή σας λειτουργεί. Αν χρησιμοποιείτε εξωτερική κάμερα, συνδέστε την πριν συνεχίσετε." />
            <vm:InstructionStep Number="2"
                Text="Στην επόμενη οθόνη επιλέξτε την κάμερα από τη λίστα «Διαθέσιμες Κάμερες». Πατήστε «Ανανέωση» αν δεν εμφανίζεται." />
            <vm:InstructionStep Number="3"
                Text="Φροντίστε το πρόσωπό σας να φωτίζεται από μπροστά. Αποφύγετε έντονο φως ή παράθυρο πίσω σας." />
            <vm:InstructionStep Number="4"
                Text="Καθίστε απέναντι από την κάμερα, με το πρόσωπό σας πλήρως μέσα στο οβάλ και το βλέμμα προς τον φακό." />
            <vm:InstructionStep Number="5"
                Text="Αφαιρέστε καπέλο, γυαλιά ηλίου ή ό,τι άλλο καλύπτει το πρόσωπό σας. Τα διορθωτικά γυαλιά μπορείτε να τα κρατήσετε, αρκεί να τα φοράτε και κατά τη σύνδεση." />
            <vm:InstructionStep Number="6"
                Text="Πατήστε «Βγάλε φωτογραφία» για κάθε λήψη. Χρειάζονται συνολικά 7 φωτογραφίες." />
            <vm:InstructionStep Number="7"
                Text="Ανάμεσα στις λήψεις αλλάξτε ελαφρώς τη στάση του κεφαλιού (λίγο αριστερά, δεξιά, πάνω, κάτω), ώστε το σύστημα να σας αναγνωρίζει από διαφορετικές γωνίες." />
            <vm:InstructionStep Number="8"
                Text="Ελέγξτε τις φωτογραφίες. Αν κάποια είναι θολή ή το πρόσωπο δεν φαίνεται καθαρά, πατήστε «Επανάληψη». Διαφορετικά πατήστε «Ολοκλήρωση»." />
        </x:Array>

        <!-- Numbered badge on the left, wrapped instruction text on the right. -->
        <DataTemplate x:Key="StepTemplate" DataType="{x:Type vm:InstructionStep}">
            <Grid Margin="0 0 0 18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border
                    Grid.Column="0"
                    Width="34" Height="34"
                    CornerRadius="17"
                    Background="{StaticResource ColorSuccess}"
                    VerticalAlignment="Top"
                    Margin="0 0 16 0">
                    <TextBlock
                        Text="{Binding Number}"
                        FontFamily="Manrope"
                        FontSize="16"
                        FontWeight="Bold"
                        Foreground="#1D1C1D"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center" />
                </Border>

                <TextBlock
                    Grid.Column="1"
                    Text="{Binding Text}"
                    TextWrapping="Wrap"
                    FontFamily="Manrope"
                    FontSize="16"
                    Foreground="White"
                    VerticalAlignment="Center" />
            </Grid>
        </DataTemplate>

    </UserControl.Resources>

    <Grid Margin="40">

        <Grid.RowDefinitions>
            <RowDefinition Height="auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="auto" />
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="3*" />
            <ColumnDefinition Width="2*" />
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0" Grid.Row="0" Grid.ColumnSpan="2" Margin="0 20 0 10">
            <TextBlock
                Text="Οδηγίες - Εγγραφή μεσω Προσώπου"
                Style="{StaticResource PageTitle}">
            </TextBlock>
        </Grid>

        <!-- STEPS -->
        <ItemsControl
            Grid.Column="0" Grid.Row="1"
            Margin="0 10 10 0"
            ItemsSource="{StaticResource Steps}"
            ItemTemplate="{StaticResource StepTemplate}" />

        <!-- ILLUSTRATION: the same positioning guide the capture screen draws over the
             camera feed, so the user recognises it when they get there. -->
        <Grid Grid.Column="1" Grid.Row="1" Margin="30 10 0 0">

            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="auto" />
            </Grid.RowDefinitions>

            <Border
                Grid.Row="0"
                Background="#141314"
                CornerRadius="8"
                Padding="16">
                <controls:FaceGuideOverlay />
            </Border>

            <TextBlock
                Grid.Row="1"
                Margin="0 12 0 0"
                Text="Έτσι θα εμφανιστεί ο οδηγός τοποθέτησης στην οθόνη λήψης."
                TextWrapping="Wrap"
                TextAlignment="Center"
                FontFamily="Manrope"
                FontSize="14"
                Foreground="#B9B9B9" />

        </Grid>

        <Grid Grid.Column="0" Grid.Row="2" Grid.ColumnSpan="2">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                <Button
                    Content="Επόμενο"
                    Command="{Binding GoToViewRegister06WithFaceCommand}"
                    Style="{StaticResource NextButton}"
                    Cursor="Hand">
                </Button>
                <Button
                    Command="{Binding GoToViewRegister04WithPalmprintCommand}"
                    Content="Πίσω"
                    Style="{StaticResource BackButton}"
                    Cursor="Hand">
                </Button>
            </StackPanel>
        </Grid>

    </Grid>
</UserControl>
