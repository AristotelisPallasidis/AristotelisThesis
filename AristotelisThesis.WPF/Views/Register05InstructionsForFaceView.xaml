<UserControl x:Class="AristotelisThesis.WPF.Views.Register05InstructionsForFaceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:AristotelisThesis.WPF.Views"
             mc:Ignorable="d" 
             d:DesignHeight="650" d:DesignWidth="1200"
             Background="#1D1C1D">
    <Grid Margin="20">

        <Grid.RowDefinitions>
            <RowDefinition Height="auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="auto" />
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0" Grid.Row="0" Margin="0 20 0 10">
            <TextBlock
                Text="Οδηγίες - Εγγραφή μεσω Προσώπου"
                Grid.Row="0"
                Style="{StaticResource PageTitle}">
            </TextBlock>
        </Grid>

        <Grid Grid.Column="0" Grid.Row="1" Margin="0 10 10 0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Grid.RowDefinitions>
                <RowDefinition Height="auto" />
                <RowDefinition Height="auto" />
                <RowDefinition Height="auto" />
                <RowDefinition Height="auto" />
                <RowDefinition Height="auto" />
                <RowDefinition Height="auto" />
            </Grid.RowDefinitions>

            <!-- Step 1 -->
            <Grid Grid.Column="0" Grid.Row="0" Margin="0 12 0 0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="auto" />
                    <RowDefinition Height="auto" />
                </Grid.RowDefinitions>
                <TextBlock
                    Text="Βήμα 1"
                    Grid.Row="0"
                    FontFamily="Manrope"
                    FontSize="22"
                    FontWeight="Bold"
                    Foreground="White"
                    Margin="0 0 0 6">
                </TextBlock>
                <TextBlock 
                    Foreground="White" 
                    Grid.Row="1"
                    FontFamily="Manrope" 
                    FontSize="16" 
                    HorizontalAlignment="Left"
                    TextAlignment="Left"
                    TextWrapping="Wrap"
                    Margin="0 0 0 10">
                    Συνδέστε την κάμερα στον υπολογιστή σας και βεβαιωθείτε ότι αναγνωρίζεται σωστά. Ελέγξτε τις ρυθμίσεις για να διασφαλίσετε ότι η κάμερα λειτουργεί κανονικά.
                </TextBlock>
            </Grid>

            <!-- Step 2 -->
            <Grid Grid.Column="0" Grid.Row="2" Margin="0 12 0 0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="auto" />
                    <RowDefinition Height="auto" />
                </Grid.RowDefinitions>
                <TextBlock
                    Text="Βήμα 2"
                    Grid.Row="0"
                    FontFamily="Manrope"
                    FontSize="22"
                    FontWeight="Bold"
                    Foreground="White"
                    Margin="0 0 0 6">
                </TextBlock>
                <TextBlock 
                    Foreground="White" 
                    Grid.Row="1"
                    FontFamily="Manrope" 
                    FontSize="16" 
                    HorizontalAlignment="Left"
                    TextAlignment="Left"
                    TextWrapping="Wrap"
                    Margin="0 0 0 10">
                    Από τη λίστα καμερών, επιλέξτε την ενσωματωμένη κάμερα του φορητού σας υπολογιστή για την καλύτερη ποιότητα.
                </TextBlock>
            </Grid>

            <!-- Step 3 -->
            <Grid Grid.Column="0" Grid.Row="4" Margin="0 12 0 0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="auto" />
                    <RowDefinition Height="auto" />
                </Grid.RowDefinitions>
                <TextBlock
                    Text="Βήμα 3"
                    Grid.Row="0"
                    FontFamily="Manrope"
                    FontSize="22"
                    FontWeight="Bold"
                    Foreground="White"
                    Margin="0 0 0 6">
                </TextBlock>
                <TextBlock 
                    Foreground="White" 
                    Grid.Row="1"
                    FontFamily="Manrope" 
                    FontSize="16" 
                    HorizontalAlignment="Left"
                    TextAlignment="Left"
                    TextWrapping="Wrap"
                    Margin="0 0 0 10">
                    Ρυθμίστε τις παραμέτρους φωτεινότητας και εστίασης της κάμερας για να εξασφαλίσετε καθαρή εικόνα.
                </TextBlock>
            </Grid>

            <!-- Step 4 -->
            <Grid Grid.Column="0" Grid.Row="6" Margin="0 12 0 0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="auto" />
                    <RowDefinition Height="auto" />
                </Grid.RowDefinitions>
                <TextBlock
                    Text="Βήμα 4"
                    Grid.Row="0"
                    FontFamily="Manrope"
                    FontSize="22"
                    FontWeight="Bold"
                    Foreground="White"
                    Margin="0 0 0 6">
                </TextBlock>
                <TextBlock 
                    Foreground="White" 
                    Grid.Row="1"
                    FontFamily="Manrope" 
                    FontSize="16" 
                    HorizontalAlignment="Left"
                    TextAlignment="Left"
                    TextWrapping="Wrap"
                    Margin="0 0 0 10">
                    Σταθείτε μπροστά στην κάμερα και βεβαιωθείτε ότι το πρόσωπό σας είναι πλήρως εντός του κάδρου.
                </TextBlock>
            </Grid>
        </Grid>

        <Grid Grid.Column="1" Grid.Row="1" Margin="0 10 10 0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Grid.RowDefinitions>
                <RowDefinition Height="auto" />
                <RowDefinition Height="auto" />
                <RowDefinition Height="auto" />
                <RowDefinition Height="auto" />
                <RowDefinition Height="auto" />
                <RowDefinition Height="auto" />
            </Grid.RowDefinitions>

            <!-- Step 5 -->
            <Grid Grid.Column="1" Grid.Row="0" Margin="0 12 0 0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="auto" />
                    <RowDefinition Height="auto" />
                </Grid.RowDefinitions>
                <TextBlock
                    Text="Βήμα 5"
                    Grid.Row="0"
                    FontFamily="Manrope"
                    FontSize="22"
                    FontWeight="Bold"
                    Foreground="White"
                    Margin="0 0 0 6">
                </TextBlock>
                <TextBlock 
                    Foreground="White" 
                    Grid.Row="1"
                    FontFamily="Manrope" 
                    FontSize="16" 
                    HorizontalAlignment="Left"
                    TextAlignment="Left"
                    TextWrapping="Wrap"
                    Margin="0 0 0 10">
                    Ακολουθήστε τις οδηγίες για να τραβήξετε 11 φωτογραφίες με διαφορετικές εκφράσεις, φωτισμό και στάσεις του προσώπου σας.
                </TextBlock>
            </Grid>

            <!-- Step 6 -->
            <Grid Grid.Column="1" Grid.Row="2" Margin="0 12 0 0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="auto" />
                    <RowDefinition Height="auto" />
                </Grid.RowDefinitions>
                <TextBlock
                    Text="Βήμα 6"
                    Grid.Row="0"
                    FontFamily="Manrope"
                    FontSize="22"
                    FontWeight="Bold"
                    Foreground="White"
                    Margin="0 0 0 6">
                </TextBlock>
                <TextBlock 
                    Foreground="White" 
                    Grid.Row="1"
                    FontFamily="Manrope" 
                    FontSize="16" 
                    HorizontalAlignment="Left"
                    TextAlignment="Left"
                    TextWrapping="Wrap"
                    Margin="0 0 0 10">
                    Ελέγξτε τις φωτογραφίες για να βεβαιωθείτε ότι είναι ευκρινείς και χρησιμοποιήσιμες για αναγνώριση προσώπου.
                </TextBlock>
            </Grid>

            <!-- Step 7 -->
            <Grid Grid.Column="1" Grid.Row="4" Margin="0 12 0 0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="auto" />
                    <RowDefinition Height="auto" />
                </Grid.RowDefinitions>
                <TextBlock
                    Text="Βήμα 7"
                    Grid.Row="0"
                    FontFamily="Manrope"
                    FontSize="22"
                    FontWeight="Bold"
                    Foreground="White"
                    Margin="0 0 0 6">
                </TextBlock>
                <TextBlock 
                    Foreground="White" 
                    Grid.Row="1"
                    FontFamily="Manrope" 
                    FontSize="16" 
                    HorizontalAlignment="Left"
                    TextAlignment="Left"
                    TextWrapping="Wrap"
                    Margin="0 0 0 10">
                    Ανεβάστε τις φωτογραφίες και προχωρήστε με την εγγραφή της αναγνώρισης προσώπου.
                </TextBlock>
            </Grid>

            <!-- Step 8 -->
            <Grid Grid.Column="1" Grid.Row="6" Margin="0 12 0 0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="auto" />
                    <RowDefinition Height="auto" />
                </Grid.RowDefinitions>
                <TextBlock
                    Text="Βήμα 8"
                    Grid.Row="0"
                    FontFamily="Manrope"
                    FontSize="22"
                    FontWeight="Bold"
                    Foreground="White"
                    Margin="0 0 0 6">
                </TextBlock>
                <TextBlock 
                    Foreground="White" 
                    Grid.Row="1"
                    FontFamily="Manrope" 
                    FontSize="16" 
                    HorizontalAlignment="Left"
                    TextAlignment="Left"
                    TextWrapping="Wrap"
                    Margin="0 0 0 10">
                    Ολοκληρώστε τη διαδικασία και επιβεβαιώστε ότι η εγγραφή σας ήταν επιτυχής.
                </TextBlock>
            </Grid>
        </Grid>
    

        <Grid Grid.Column="0" Grid.Row="2">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                <Button 
                    Content="Επόμενο"
                    Style="{StaticResource NextButton}"
                    Cursor="Hand">
                </Button>
                <Button 
                    Content="Πίσω"
                    Style="{StaticResource BackButton}"
                    Cursor="Hand">
                </Button>
            </StackPanel>
        </Grid>

    </Grid>
</UserControl>
