<UserControl x:Class="AristotelisThesis.WPF.Views.LoginView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:AristotelisThesis.WPF.Views"
             xmlns:style="clr-namespace:AristotelisThesis.WPF"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800" Background="#1D1C1D">
    <Grid Margin="30">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0" VerticalAlignment="Center">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="*" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Image 
                Grid.Row="0"
                Source="C:\Users\Aristotelis\source\repos\AristotelisThesis\AristotelisThesis.WPF\Assets\App_Logo.png"
                HorizontalAlignment="Left"
                Height="50" 
                Width="50">
            </Image>

            <TextBlock 
                Grid.Row="1"
                TextWrapping="Wrap"
                FontWeight="Bold"
                Margin="0 6"
                FontFamily="Manrope"
                Foreground="White" 
                FontSize="40">
                    ΔΙΠΑΕ Σύστημα
                    <LineBreak />
                    Ταυτοποίησης
            </TextBlock>

            <TextBlock 
                Grid.Row="2"
                Text="Το μέλλον των συστημάτων ελέγχου ταυτότητας" 
                FontFamily="Manrope"
                Foreground="White" 
                FontSize="15">
            </TextBlock>

        </Grid>



        <Grid Grid.Column="1" VerticalAlignment="Center">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="auto" />
                <RowDefinition Height="auto" />
                <RowDefinition Height="auto" />
                <RowDefinition Height="auto" />
            </Grid.RowDefinitions>


            <TextBlock 
                Grid.Row="0"
                VerticalAlignment="Center"
                HorizontalAlignment="Center"
                FontWeight="Bold"
                Text="Σύνδεση" 
                FontFamily="Manrope"
                Padding="10 10 10 10" 
                Foreground="White" 
                FontSize="25">
            </TextBlock>

            <Button
                Grid.Row="1"
                Content="Σύνδεση μέσω Προσώπου"
                FontFamily="Manrope"
                Foreground="White" 
                FontSize="12" 
                HorizontalAlignment="Center"
                BorderThickness="0"
                Padding="17 8"
                Cursor="Hand"
                Background="#000000" 
                Margin="0 0 0 10">
            </Button>

            <Button
                Grid.Row="2"
                Content="Σύνδεση μέσω Παλάμης" 
                Foreground="White" 
                FontSize="12" 
                HorizontalAlignment="Center"
                FontFamily="Manrope"
                BorderThickness="0"
                Padding="24 8"
                Cursor="Hand"
                Background="#000000">
            </Button>

            <TextBlock
                Grid.Row="3"
                HorizontalAlignment="Center"
                Text="ή" 
                Margin="0 10" 
                Foreground="White" 
                FontFamily="Manrope"
                FontSize="13">
            </TextBlock>

            <Button
                Grid.Row="4"
                Content="Δημιουργία Λογαρισμού"
                FontFamily="Manrope"
                Foreground="White"
                FontSize="12"
                HorizontalAlignment="Center"
                BorderBrush="White"
                BorderThickness="0 0 0 1"
                Padding="24 8"
                Cursor="Hand"
                Background="#1D1C1D">
            </Button>

        </Grid>


    </Grid>
</UserControl>
