<UserControl x:Class="AristotelisThesis.WPF.Views.LoginView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:AristotelisThesis.WPF.Views"
             xmlns:style="clr-namespace:AristotelisThesis.WPF"
             mc:Ignorable="d" 
             d:DesignHeight="850" d:DesignWidth="1440" 
             Background="#1D1C1D">
    
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0" VerticalAlignment="Center" HorizontalAlignment="Center">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0">
                <Image 
                    Source="C:\Users\Aristotelis\Desktop\test2\AristotelisThesis\AristotelisThesis.WPF\Assets\duth-logo-white.png"
                    Height="200" 
                    Width="200">
                </Image>
            </Grid>

            <Grid Grid.Column="1" VerticalAlignment="Center">
                <Grid.RowDefinitions>
                    <RowDefinition Height="auto" />
                    <RowDefinition Height="auto" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0 4">
                    <TextBlock 
                        FontWeight="Bold"
                        Foreground="{StaticResource ColorLight}" 
                        FontSize="44">
                            ΔΠΘ Σύστημα
                            <LineBreak />
                            Ταυτοποίησης
                    </TextBlock>
                </Grid>

                <Grid Grid.Row="1">
                    <TextBlock 
                         Text="Το μέλλον των συστημάτων ελέγχου ταυτότητας" 
                         Foreground="{StaticResource ColorLight}" 
                         FontSize="16">
                    </TextBlock>

                </Grid>
            </Grid>

        </Grid>

        

        <Grid Grid.Column="1" VerticalAlignment="Center">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="auto" />
                <RowDefinition Height="auto" />
                <RowDefinition Height="auto" />
                <RowDefinition Height="auto" />
                
                <RowDefinition Height="auto" />
                <RowDefinition Height="auto" />
                <RowDefinition Height="auto" />
                <RowDefinition Height="auto" />
                <RowDefinition Height="auto" />
            </Grid.RowDefinitions>

            <TextBlock 
                Grid.Row="0"
                VerticalAlignment="Center"
                HorizontalAlignment="Center"
                FontWeight="Bold"
                Text="Σύνδεση" 
                FontFamily="Manrope"
                Padding="0 30" 
                Foreground="White" 
                FontSize="34">
            </TextBlock>

            <Grid Grid.Row="1" Margin="0 0 0 10">
                <Button
                    Content="Σύνδεση μέσω Προσώπου"
                    Command="{Binding GoToViewLoginWithFaceCommand}"
                    Width="300"
                    FontSize="16" 
                    BorderThickness="0"
                    Cursor="Hand"
                    Padding="24 8">
                </Button>
            </Grid>

            <Button
                Grid.Row="2"
                Content="Σύνδεση μέσω Παλάμης" 
                Command="{Binding GoToViewLoginWithPalmprintCommand}"
                Width="300"
                FontSize="16" 
                BorderThickness="0"
                Padding="24 8"
                Cursor="Hand">
            </Button>

            <TextBlock
                Grid.Row="3"
                HorizontalAlignment="Center"
                Text="ή" 
                Margin="0 10" 
                Foreground="White" 
                FontFamily="Manrope"
                FontSize="16">
            </TextBlock>

            <Button
                Grid.Row="4"
                Content="Δημιουργία Λογαρισμού"
                Command="{Binding GoToViewRegister01Command}"
                Foreground="White"
                FontSize="16"
                Width="300"
                HorizontalAlignment="Center"
                BorderBrush="White"
                BorderThickness="0 0 0 1"
                Padding="24 8"
                Cursor="Hand"
                Background="#1D1C1D">
            </Button>
            
            <!-- ////////////////////////// -->

            <Grid Grid.Row="5" Width="300">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid Grid.Column="0">
                    <StackPanel Orientation="Vertical">
                    <TextBlock 
                        Text="Username" 
                        FontSize="12" 
                        Foreground="white" 
                        Width="120">
                    </TextBlock>
                    <TextBox 
                        Width="120"
                        FontSize="10" 
                        Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}">
                    </TextBox>
                    </StackPanel>
                </Grid>
                <Grid Grid.Column="1">
                    <StackPanel Orientation="Vertical" HorizontalAlignment="Stretch">
                        <TextBlock Width="120" Text="Password" FontSize="16" Foreground="white"></TextBlock>
                        <PasswordBox 
                            Width="120"
                            FontSize="10" 
                            x:Name="pbPassword">
                        </PasswordBox>
                    </StackPanel>
                </Grid>
            </Grid>



            <Button 
                Width="120" 
                Grid.Row="6"
                FontSize="10"
                IsDefault="True"
                Content="Login" 
                Click="Login_Click"
                Margin="0 6 ">
            </Button>
        </Grid>

    </Grid>
    
</UserControl>
