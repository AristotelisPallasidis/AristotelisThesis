<UserControl x:Class="AristotelisThesis.WPF.Views.LoginView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:AristotelisThesis.WPF.Views"
             xmlns:style="clr-namespace:AristotelisThesis.WPF"
             mc:Ignorable="d" 
             d:DesignHeight="850" d:DesignWidth="1440" 
             Background="#1D1C1D">
    
    <Grid Margin="30">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0" VerticalAlignment="Center" HorizontalAlignment="Center">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0">
                <Image 
                    Source="C:\Users\Aristotelis\Desktop\test2\AristotelisThesis\AristotelisThesis.WPF\Assets\duth-logo-white.png"
                    Height="200" 
                    Width="200">
                </Image>
            </Grid>

            <Grid Grid.Column="1" VerticalAlignment="Center">
                <Grid.RowDefinitions>
                    <RowDefinition Height="auto" />
                    <RowDefinition Height="auto" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <TextBlock 
                        FontWeight="Bold"
                        Margin="0 6"
                        FontFamily="Manrope"
                        Foreground="White" 
                        FontSize="44">
                            ΔΠΘ Σύστημα
                            <LineBreak />
                            Ταυτοποίησης
                    </TextBlock>
                </Grid>

                <Grid Grid.Row="1">
                    <TextBlock 
                         Text="Το μέλλον των συστημάτων ελέγχου ταυτότητας" 
                         FontFamily="Manrope"
                         Foreground="White" 
                         FontSize="16">
                    </TextBlock>

                </Grid>
            </Grid>

        </Grid>

        

        <Grid Grid.Column="1" VerticalAlignment="Center">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="auto" />
                <RowDefinition Height="auto" />
                <RowDefinition Height="auto" />
                <RowDefinition Height="auto" />
                
                <RowDefinition Height="auto" />
                <RowDefinition Height="auto" />
                <RowDefinition Height="auto" />
                <RowDefinition Height="auto" />
                <RowDefinition Height="auto" />
            </Grid.RowDefinitions>

            <TextBlock 
                Grid.Row="0"
                VerticalAlignment="Center"
                HorizontalAlignment="Center"
                FontWeight="Bold"
                Text="Σύνδεση" 
                FontFamily="Manrope"
                Padding="0 30" 
                Foreground="White" 
                FontSize="34">
            </TextBlock>

            <Button
                Grid.Row="1"
                Content="Σύνδεση μέσω Προσώπου"
                Command="{Binding ViewLoginWithFaceCommand}"
                FontFamily="Manrope"
                Foreground="White" 
                FontSize="16" 
                HorizontalAlignment="Center"
                BorderThickness="0"
                Padding="32 14"
                Cursor="Hand"
                Background="#303030" 
                Margin="0 0 0 10">
            </Button>

            <Button
                Grid.Row="2"
                Content="Σύνδεση μέσω Παλάμης" 
                Command="{Binding ViewLoginWithPalmprintCommand}"
                Foreground="White" 
                FontSize="16" 
                HorizontalAlignment="Center"
                FontFamily="Manrope"
                BorderThickness="0"
                Padding="32 14"
                Cursor="Hand"
                Background="#303030">
            </Button>

            <TextBlock
                Grid.Row="3"
                HorizontalAlignment="Center"
                Text="ή" 
                Margin="0 10" 
                Foreground="White" 
                FontFamily="Manrope"
                FontSize="16">
            </TextBlock>

            <Button
                Grid.Row="4"
                Content="Δημιουργία Λογαρισμού"
                Command="{Binding ViewRegisterCommand}"
                FontFamily="Manrope"
                Foreground="White"
                FontSize="12"
                HorizontalAlignment="Center"
                BorderBrush="White"
                BorderThickness="0 0 0 1"
                Padding="24 8"
                Cursor="Hand"
                Background="#1D1C1D">
            </Button>

            <TextBlock Grid.Row="5" Text="Username" FontSize="16" Foreground="white" Width="120"></TextBlock>
            <TextBox Grid.Row="6" Width="120" FontSize="16" Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}"></TextBox>

            <TextBlock Grid.Row="7" Width="120" Text="Password" FontSize="16" Foreground="white"></TextBlock>
            <TextBox Grid.Row="8" Width="120" FontSize="16" Text="{Binding Password, UpdateSourceTrigger=PropertyChanged}"></TextBox>

            <Button Grid.Row="9" Width="120" x:Name="loginButton" Content="Login" Margin="0 30 "></Button>
        </Grid>

    </Grid>
    
</UserControl>
