<UserControl x:Class="AristotelisThesis.WPF.Views.Register03InstructionsForPalmprintView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:AristotelisThesis.WPF.Views"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800" Background="#1D1C1D">
    <Grid Margin="20">

        <Grid.RowDefinitions>
            <RowDefinition Height="auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="auto" />
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0" Grid.Row="0" Margin="0 20 0 10">
            <TextBlock
            Text="Οδηγίες - Εγγραφή μέσω Παλάμης"
            Grid.Row="0"
            FontFamily="Manrope"
            FontSize="20"
            FontWeight="Bold"
            Foreground="White"
            >
            </TextBlock>
        </Grid>

        <Grid Grid.Column="0" Grid.Row="1" Margin="0 10 0 0">
            <Grid.RowDefinitions>
                <RowDefinition Height="auto" />
                <RowDefinition Height="auto" />

                <RowDefinition Height="auto" />
                <RowDefinition Height="auto" />

                <RowDefinition Height="auto" />
                <RowDefinition Height="auto" />

                <RowDefinition Height="auto" />
                <RowDefinition Height="auto" />
            </Grid.RowDefinitions>

            <!-- Step 1 -->
            <TextBlock
                Grid.Row="0"
                Text="Βημα 1"
                FontFamily="Manrope"
                FontSize="12"
                FontWeight="Bold"
                Foreground="White"
                Margin="0 0 0 6">
            </TextBlock>
            <TextBlock 
                Grid.Row="1"
                Foreground="White" 
                FontFamily="Manrope" 
                FontSize="10" 
                HorizontalAlignment="Left"
                TextAlignment="Left">
                Βεβαιωθειτε οτι η συσκευη ειναι συνδεδεμενη με τον υπολογιστή
            </TextBlock>

            <!-- Step 2 -->
            <TextBlock
                Grid.Row="2"
                Text="Βημα 2"
                FontFamily="Manrope"
                FontSize="14"
                FontWeight="Bold"
                Foreground="White"
                Margin="0,11,0,5">
            </TextBlock>
            <TextBlock 
                Grid.Row="3"
                Foreground="White" 
                FontFamily="Manrope" 
                FontSize="10" 
                HorizontalAlignment="Left"
                TextAlignment="Left">
                Τοποθετήστε την παλάμη σας πανω απο την τρυπα στην συσκευη
            </TextBlock>

            <!-- Step 3 -->
            <TextBlock
                Grid.Row="4"
                Text="Βημα 3"
                FontFamily="Manrope"
                FontSize="14"
                FontWeight="Bold"
                Foreground="White"
                Margin="0 10 0 6">
            </TextBlock>
            <TextBlock 
                Grid.Row="5"
                Foreground="White" 
                FontFamily="Manrope" 
                FontSize="10" 
                HorizontalAlignment="Left"
                TextAlignment="Left">
                    Βεβαιωθειτε οτι η συσκευη ειναι συνδεδεμενη με τον υπολογιστή
            </TextBlock>

            <!-- Step 4 -->
            <TextBlock
                Grid.Row="6"
                Text="Βήμα 4"
                FontFamily="Manrope"
                FontSize="14"
                FontWeight="Bold"
                Foreground="White"
                Margin="0 10 0 6">
            </TextBlock>
            <TextBlock 
                Grid.Row="7"
                Foreground="White" 
                FontFamily="Manrope" 
                FontSize="10" 
                HorizontalAlignment="Left"
                TextAlignment="Left">
                    Βεβαιωθειτε οτι η συσκευη ειναι συνδεδεμενη με τον υπολογιστή
            </TextBlock>

        </Grid>

        <Grid Grid.Column="1" Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="auto" />
                <RowDefinition Height="auto" />
                <RowDefinition Height="auto" />
                <RowDefinition Height="auto" />
                <RowDefinition Height="auto" />
                <RowDefinition Height="auto" />
                <RowDefinition Height="auto" />
                <RowDefinition Height="auto" />
                <RowDefinition Height="auto" />
                <RowDefinition Height="auto" />
                <RowDefinition Height="auto" />
            </Grid.RowDefinitions>


        </Grid>

        <Grid Grid.Column="0" Grid.Row="2">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                <Button 
                    Content="Επόμενο"
                    Style="{StaticResource NextButton}"
                    Cursor="Hand">
                </Button>
                <Button 
                    Content="Πίσω"
                    Style="{StaticResource BackButton}"
                    Cursor="Hand">
                </Button>
            </StackPanel>
        </Grid>

    </Grid>
</UserControl>
