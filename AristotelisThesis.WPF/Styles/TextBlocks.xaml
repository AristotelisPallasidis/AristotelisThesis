<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">


    <!-- PAGE TITLE -->
    <Style x:Key="PageTitle" TargetType="TextBlock">

        <Setter Property="Foreground" Value="{StaticResource ColorLight}" />

        <Setter Property="FontSize" Value="34" />
        <Setter Property="FontWeight" Value="ExtraBold" />
        <Setter Property="FontFamily" Value="Manrope" />

    </Style>


    <!-- TEXT ABOVE INPUT BOX -->
    <Style x:Key="TextBlockOfInput" TargetType="TextBlock">

        <Setter Property="Width" Value="240" />

        <Setter Property="Margin" Value="0 24 0 4" />

        <Setter Property="Foreground" Value="{StaticResource ColorLight}" />

        <Setter Property="FontSize" Value="16" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="FontFamily" Value="Manrope" />

        <Setter Property="HorizontalAlignment" Value="Left" />

    </Style>



</ResourceDictionary>