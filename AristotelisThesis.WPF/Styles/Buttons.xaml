<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- LOGIN WITH FACE BUTTON -->
    <Style x:Key="LoginWithFaceButton">

    </Style>

    <!-- LOGIN WITH PALMPRINT BUTTON -->
    <Style x:Key="LoginWithPalmprintButton" TargetType="Button">

        <Setter Property="Width" Value="100" />

        <Setter Property="Padding" Value="0 3" />

        <Setter Property="Foreground" Value="#1D1C1D" />
        <Setter Property="Background" Value="#BEDB39" />

        <Setter Property="BorderThickness" Value="0" />

        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />

        <Setter Property="FontFamily" Value="Manrope" />
        <Setter Property="FontWeight" Value="SemiBold" />

        <Setter Property="Cursor" Value="Hand" />

    </Style>





    <!-- /////////////////////////////////////////////////////////////// -->
    <!-- REGISTRATION BUTTONS -->
    <!-- /////////////////////////////////////////////////////////////// -->

    <!-- NEXT BUTTON -->
    <Style x:Key="NextButton" TargetType="Button">

        <Setter Property="Width" Value="120" />

        <Setter Property="Padding" Value="0 6" />

        <Setter Property="Foreground" Value="#1D1C1D" />
        <Setter Property="Background" Value="#BEDB39" />

        <Setter Property="BorderThickness" Value="0" />

        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />

        <Setter Property="FontSize" Value="16" />
        <Setter Property="FontWeight" Value="SemiBold" />

        <Setter Property="Cursor" Value="Hand" />

    </Style>


    <!-- BACK BUTTON -->
    <Style x:Key="BackButton" TargetType="Button">

        <Setter Property="Width" Value="120" />

        <Setter Property="Padding" Value="0 6" />

        <Setter Property="Foreground" Value="{StaticResource ColorLight}" />
        <Setter Property="Background" Value="Transparent" />

        <Setter Property="BorderThickness" Value="0" />

        <Setter Property="FontSize" Value="16" />
        <Setter Property="FontWeight" Value="Regular" />

        <Setter Property="Cursor" Value="Hand" />

    </Style>





    <!-- /////////////////////////////////////////////////////////////// -->
    <!-- STATISTICS BUTTONS -->
    <!-- /////////////////////////////////////////////////////////////// -->

    <!-- SAVE CHANGES BUTTION -->
    <Style x:Key="SaveChangesButton" TargetType="Button">

        <Setter Property="Padding" Value="30 2" />

        <Setter Property="Foreground" Value="{StaticResource ColorLight}" />
        <Setter Property="Background" Value="{StaticResource ColorSuccess}" />

        <Setter Property="BorderThickness" Value="0" />

        <Setter Property="FontFamily" Value="Manrope" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="FontWeight" Value="SemiBold" />

        <Setter Property="Cursor" Value="Hand" />

        <!-- Trigger to change background color on hover -->
        <Style.Triggers>
            <EventTrigger RoutedEvent="MouseEnter">
                <BeginStoryboard>
                    <Storyboard>
                        <ColorAnimation To="#218838" Duration="0:0:0.1" Storyboard.TargetProperty="Background.Color"/>
                    </Storyboard>
                </BeginStoryboard>
            </EventTrigger>
            <EventTrigger RoutedEvent="MouseLeave">
                <BeginStoryboard>
                    <Storyboard>
                        <ColorAnimation To="#218838" Duration="0:0:0.1" Storyboard.TargetProperty="Background.Color"/>
                    </Storyboard>
                </BeginStoryboard>
            </EventTrigger>
        </Style.Triggers>

    </Style>


    <!-- DELETE ACCOUNT BUTTION -->
    <Style x:Key="DeleteAccountButton" TargetType="Button">

        <Setter Property="Width" Value="100" />

        <Setter Property="Margin" Value="0 12 0 0" />
        <Setter Property="Padding" Value="12 6" />

        <Setter Property="Foreground" Value="{StaticResource ColorLight}" />
        <Setter Property="Background" Value="{StaticResource ColorDanger}" />

        <Setter Property="BorderThickness" Value="0" />

        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="HorizontalAlignment" Value="Left" />

        <Setter Property="FontFamily" Value="Manrope" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="FontWeight" Value="SemiBold" />

        <Setter Property="Cursor" Value="Hand" />

    </Style>

</ResourceDictionary>