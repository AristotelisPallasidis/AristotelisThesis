<UserControl x:Class="AristotelisThesis.WPF.Controls.WeeklyActiveHoursCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             
             xmlns:local="clr-namespace:AristotelisThesis.WPF.Controls"
             
             mc:Ignorable="d">


    <Grid>

        <Grid.RowDefinitions>
            <RowDefinition Height="auto" />
        </Grid.RowDefinitions>

        <Border
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch"
            Background="#E6E6E6"
            Padding="12"
            CornerRadius="8 8 8 8">


            <Grid Grid.Row="0" Margin="10 0 0 0">

                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>


                <Grid Grid.Row="0">
                    <TextBlock 
                        Text="Εβδομαδιαίο σύνολο ώρων σύνδεσης" 
                        FontSize="20">
                    </TextBlock>
                </Grid>


                <Grid Grid.Row="1" Margin="0 114 0 0">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Grid Grid.Column="0">
                        <StackPanel Orientation="Vertical">

                            <TextBlock 
                                Text="67" 
                                Foreground="Black" 
                                FontSize="60"
                                FontWeight="Black"
                                HorizontalAlignment="Left" 
                                Margin="0 10">
                            </TextBlock>

                        </StackPanel>
                    </Grid>

                </Grid>


            </Grid>


        </Border>

    </Grid>


</UserControl>
