<UserControl x:Class="AristotelisThesis.WPF.Controls.ClockCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:AristotelisThesis.WPF.Controls"
             mc:Ignorable="d" 
             d:DesignWidth="400">


    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto" />
        </Grid.RowDefinitions>

        <Border
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch"
            Background="#E6E6E6"
            Padding="12"
            CornerRadius="8 8 8 8">

            <Grid Grid.Row="0" Margin="10 0 0 0">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0" Margin="0 0 10 0">
                    <TextBlock
                        x:Name="ActiveGender"
                        Text="Διάρκεια σύνδεσης"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Foreground="{StaticResource ColorDark}"
                        FontFamily="Manrope"
                        FontSize="12">
                    </TextBlock>
                </Grid>


                <Grid Grid.Column="1">
                    <TextBlock
                        x:Name="SessionTimeTextBlock"
                        Text="—"
                        VerticalAlignment="Center"
                        Foreground="{StaticResource ColorDark}"
                        FontFamily="Manrope"
                        FontWeight="Bold"
                        FontSize="13">
                    </TextBlock>
                </Grid>

            </Grid>

        </Border>

    </Grid>


</UserControl>
