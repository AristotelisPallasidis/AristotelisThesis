<UserControl x:Class="AristotelisThesis.WPF.Controls.NavigationBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:AristotelisThesis.WPF.Controls"
             xmlns:nav="clr-namespace:AristotelisThesis.WPF.State.Navigators"
             xmlns:vm="clr-namespace:AristotelisThesis.WPF.ViewModels"
             xmlns:converters="clr-namespace:AristotelisThesis.WPF.Converters"
             mc:Ignorable="d" 
             d:DesignHeight="80" d:DesignWidth="1400">

    <UserControl.Resources>
        <converters:EqualValueToParameterConverter x:Key="EqualValueToParameterConverter" />
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
        </Grid.RowDefinitions>


        <Grid Grid.Row="0" HorizontalAlignment="Stretch">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="auto" />
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0">
                <StackPanel Orientation="Horizontal">
                    <Image 
                        Source="/Assets/DUTH-Logo.jpg"
                        Height="60"
                        Width="60">
                    </Image>

                    <TextBlock 
                        Padding="0 10"
                        Foreground="{StaticResource ColorDark}"
                        FontSize="20" 
                        FontWeight="ExtraBold"
                        VerticalAlignment="Center">
                        ΔΠΘ ΣΥΣΤΗΜΑ
                        <LineBreak />
                        ΤΑΥΤΟΠΟΙΗΣΗΣ
                    </TextBlock>
                </StackPanel>
            </Grid>

            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                <RadioButton 
                    Style="{StaticResource NavButton}"
                    Content="Αρχική"
                    IsChecked="{Binding Navigator.CurrentViewModel, Mode=OneWay, Converter={StaticResource EqualValueToParameterConverter}, ConverterParameter={x:Type vm:DashboardViewModel}}"
                    Command="{Binding UpdateCurrentViewModelCommand}"
                    CommandParameter="{x:Static nav:ViewType.Dashboard}" />

                <RadioButton 
                    Style="{StaticResource NavButton}"
                    Content="Αναγνώριση Προσώπου"
                    IsChecked="{Binding Navigator.CurrentViewModel, Mode=OneWay, Converter={StaticResource EqualValueToParameterConverter}, ConverterParameter={x:Type vm:FaceRecognitionViewModel}}"
                    Command="{Binding UpdateCurrentViewModelCommand}"
                    CommandParameter="{x:Static nav:ViewType.FaceRecognition}" />

                <RadioButton 
                    Style="{StaticResource NavButton}"
                    Content="Αναγνώριση Παλάμης"
                    IsChecked="{Binding Navigator.CurrentViewModel, Mode=OneWay, Converter={StaticResource EqualValueToParameterConverter}, ConverterParameter={x:Type vm:PalmprintRecognitionViewModel}}"
                    Command="{Binding UpdateCurrentViewModelCommand}"
                    CommandParameter="{x:Static nav:ViewType.PalmprintRecognition}" />

                <RadioButton 
                    Style="{StaticResource NavButton}"
                    Content="Στατιστικά"
                    IsChecked="{Binding Navigator.CurrentViewModel, Mode=OneWay, Converter={StaticResource EqualValueToParameterConverter}, ConverterParameter={x:Type vm:StatisticsViewModel}}"
                    Command="{Binding UpdateCurrentViewModelCommand}"
                    CommandParameter="{x:Static nav:ViewType.Statistics}" />

                <RadioButton 
                    Style="{StaticResource NavButton}"
                    Content="Προφιλ"
                    IsChecked="{Binding Navigator.CurrentViewModel, Mode=OneWay, Converter={StaticResource EqualValueToParameterConverter}, ConverterParameter={x:Type vm:ProfileViewModel}}"
                    Command="{Binding UpdateCurrentViewModelCommand}"
                    CommandParameter="{x:Static nav:ViewType.Profile}" />

                <RadioButton 
                    Style="{StaticResource NavButton}"
                    Content="Ρυθμίσης"
                    IsChecked="{Binding Navigator.CurrentViewModel, Mode=OneWay, Converter={StaticResource EqualValueToParameterConverter}, ConverterParameter={x:Type vm:SettingsViewModel}}"
                    Command="{Binding UpdateCurrentViewModelCommand}"
                    CommandParameter="{x:Static nav:ViewType.Settings}" />
            </StackPanel>

            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                <local:ClockCard
                    LoginTime="{Binding LoginTime}"
                    MinWidth="210"
                    Margin="0 0 16 0"
                    VerticalAlignment="Center" />

                <RadioButton
                    Content="Αποσύνδεση"
                    Command="{Binding LogoutCommand}"
                    Style="{StaticResource LogoutButton}"
                    VerticalAlignment="Center">
                </RadioButton>
            </StackPanel>

        </Grid>
    </Grid>
</UserControl>
