<UserControl x:Class="AristotelisThesis.WPF.Controls.WeeklyAverageActiveTimeCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:AristotelisThesis.WPF.Controls"
             mc:Ignorable="d" 
                      d:DesignHeight="200" d:DesignWidth="340">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto" />
        </Grid.RowDefinitions>

        <Border
        HorizontalAlignment="Stretch"
        VerticalAlignment="Stretch"
        Background="#E6E6E6"
        Padding="12"
        CornerRadius="8 8 8 8">

            <Grid Grid.Row="0" Margin="6 6 0 0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <TextBlock 
                    Text="Μέση ώρα παραμονής εβδομάδας" 
                    FontWeight="Medium" 
                    FontSize="16">
                    </TextBlock>
                </Grid>


                <Grid Grid.Row="1" Margin="0 30 0 0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock
                        Text="05"
                        Foreground="Black"
                        VerticalAlignment="Bottom"
                        FontSize="70"
                        FontWeight="Black">
                        </TextBlock>
                        <TextBlock
                        Text="ώρες"
                        VerticalAlignment="Bottom"
                        Foreground="Black"
                        Opacity="0.7"
                        FontSize="16"
                        FontWeight="Black"
                        HorizontalAlignment="Center"
                        Margin="4 0 20 16">
                        </TextBlock>
                        <TextBlock
                        Text="21"
                        Foreground="Black"
                        VerticalAlignment="Bottom"
                        FontSize="70"
                        FontWeight="Black">
                        </TextBlock>
                        <TextBlock
                        Text="λεπτά"
                        VerticalAlignment="Bottom"
                        Foreground="Black"
                        Opacity="0.7"
                        FontSize="16"
                        FontWeight="Black"
                        HorizontalAlignment="Center"
                        Margin="0 16">
                        </TextBlock>
                    </StackPanel>


                </Grid>

            </Grid>

        </Border>

    </Grid>
</UserControl>
