<UserControl x:Class="AristotelisThesis.WPF.Controls.FaceGuideOverlay"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignWidth="640" d:DesignHeight="480"
             IsHitTestVisible="False"
             Background="Transparent">

    <!-- A non-interactive face-positioning guide drawn over the camera feed. The user lines
         their face up inside the oval, which keeps them at a consistent distance (fill the
         oval = right distance; too small = too far, cropped = too close). -->
    <Viewbox Stretch="Uniform">
        <Grid Width="600" Height="700">

            <!-- Soft outer oval -->
            <Ellipse Width="400" Height="540"
                     HorizontalAlignment="Center" VerticalAlignment="Center"
                     Stroke="White" StrokeThickness="3" Opacity="0.35" />

            <!-- Dashed target oval -->
            <Ellipse Width="360" Height="500"
                     HorizontalAlignment="Center" VerticalAlignment="Center"
                     Stroke="#66FF99" StrokeThickness="5"
                     StrokeDashArray="4 2" Opacity="0.9" />

            <TextBlock Text="Τοποθετήστε το πρόσωπό σας μέσα στο οβάλ"
                       HorizontalAlignment="Center" VerticalAlignment="Top"
                       Margin="0 24 0 0"
                       Foreground="White" FontSize="18" FontWeight="Bold" Opacity="0.9" />

            <TextBlock Text="Ούτε πολύ κοντά, ούτε πολύ μακριά"
                       HorizontalAlignment="Center" VerticalAlignment="Bottom"
                       Margin="0 0 0 28"
                       Foreground="White" FontSize="14" Opacity="0.8" />
        </Grid>
    </Viewbox>
</UserControl>
